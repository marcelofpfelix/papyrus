{
  "name": "astro-papyrus",
  "version": "0.2.2",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "private": false,
  "description": "Pure-backed Astro theme for blogs, docs, projects, profiles, search, RSS, and generated metadata.",
  "license": "MIT",
  "homepage": "https://github.com/marcelofpfelix/papyrus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelofpfelix/papyrus.git"
  },
  "bugs": {
    "url": "https://github.com/marcelofpfelix/papyrus/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "docs",
    "portfolio",
    "astro-pure",
    "theme"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
