{
  "name": "astro-theme-papyrus",
  "version": "0.2.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "private": false,
  "description": "Pure-backed Astro theme for blogs, docs, projects, profiles, search, RSS, and generated metadata.",
  "license": "MIT",
  "homepage": "https://github.com/marcelofpfelix/papyrus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelofpfelix/papyrus.git"
  },
  "bugs": {
    "url": "https://github.com/marcelofpfelix/papyrus/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "docs",
    "portfolio",
    "astro-pure",
    "astropaper"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./config": "./src/config/index.ts",
    "./content": "./src/content.ts",
    "./integration": "./src/integration.ts",
    "./PaperBaseLayout.astro": "./src/layouts/PaperBaseLayout.astro",
    "./PaperPostLayout.astro": "./src/layouts/PaperPostLayout.astro",
    "./PaperHeader.astro": "./src/components/PaperHeader.astro",
    "./PaperFooter.astro": "./src/components/PaperFooter.astro",
    "./PaperPostList.astro": "./src/components/PaperPostList.astro",
    "./PaperThemeProvider.astro": "./src/components/PaperThemeProvider.astro",
    "./PaperTagList.astro": "./src/components/PaperTagList.astro",
    "./PaperArchiveList.astro": "./src/components/PaperArchiveList.astro",
    "./PaperAdjacentPosts.astro": "./src/components/PaperAdjacentPosts.astro",
    "./PaperToc.astro": "./src/components/PaperToc.astro",
    "./PaperNoteList.astro": "./src/components/PaperNoteList.astro",
    "./PaperProjectList.astro": "./src/components/PaperProjectList.astro",
    "./PaperPluginList.astro": "./src/components/PaperPluginList.astro",
    "./PaperGiscusComments.astro": "./src/components/PaperGiscusComments.astro",
    "./PaperRemotePostStats.astro": "./src/components/PaperRemotePostStats.astro",
    "./PaperContentIndex.astro": "./src/components/PaperContentIndex.astro",
    "./PaperSectionMenu.astro": "./src/components/PaperSectionMenu.astro",
    "./PaperArtifactLink.astro": "./src/components/PaperArtifactLink.astro",
    "./PaperGithubCard.astro": "./src/components/PaperGithubCard.astro",
    "./PaperLinkPreview.astro": "./src/components/PaperLinkPreview.astro",
    "./PaperTimeline.astro": "./src/components/PaperTimeline.astro",
    "./PaperNotFound.astro": "./src/components/PaperNotFound.astro",
    "./runtime/PaperBackToTopRuntime.astro": "./src/components/runtime/PaperBackToTopRuntime.astro",
    "./runtime/PaperMediaRuntime.astro": "./src/components/runtime/PaperMediaRuntime.astro",
    "./runtime/PaperPostActionsRuntime.astro": "./src/components/runtime/PaperPostActionsRuntime.astro",
    "./remark-artifact-links": "./src/markdown/remark-artifact-links.mjs",
    "./remark-mermaid-blocks": "./src/markdown/remark-mermaid-blocks.mjs",
    "./rehype-task-list-labels": "./src/markdown/rehype-task-list-labels.mjs",
    "./shiki": "./src/shiki/index.mjs",
    "./utils": "./src/utils/index.ts",
    "./paper.css": "./src/styles/paper.css",
    "./themes/pure.css": "./src/styles/themes/pure.css",
    "./themes/catppuccin.css": "./src/styles/themes/catppuccin.css",
    "./themes/tokyo-night.css": "./src/styles/themes/tokyo-night.css",
    "./themes/kanagawa.css": "./src/styles/themes/kanagawa.css",
    "./themes/rose-pine.css": "./src/styles/themes/rose-pine.css",
    "./themes/everforest.css": "./src/styles/themes/everforest.css",
    "./themes/dracula.css": "./src/styles/themes/dracula.css",
    "./themes/gruvbox.css": "./src/styles/themes/gruvbox.css",
    "./themes/nord.css": "./src/styles/themes/nord.css",
    "./PaperCvProfile.astro": "./src/components/PaperCvProfile.astro",
    "./PaperCvHero.astro": "./src/components/PaperCvHero.astro",
    "./PaperCvLinks.astro": "./src/components/PaperCvLinks.astro",
    "./PaperCvSections.astro": "./src/components/PaperCvSections.astro",
    "./PaperCvExportActions.astro": "./src/components/PaperCvExportActions.astro",
    "./PaperCvA4Page.astro": "./src/components/PaperCvA4Page.astro",
    "./PaperJekyllCvPage.astro": "./src/components/PaperJekyllCvPage.astro",
    "./PaperAiMetadata.astro": "./src/components/PaperAiMetadata.astro",
    "./template/pages/index.astro": "./src/template/pages/index.astro",
    "./template/pages/posts/index.astro": "./src/template/pages/posts/index.astro",
    "./template/pages/posts/[...slug].astro": "./src/template/pages/posts/[...slug].astro",
    "./template/pages/projects.astro": "./src/template/pages/projects.astro",
    "./template/pages/profile/index.astro": "./src/template/pages/profile/index.astro",
    "./template/pages/tag/index.astro": "./src/template/pages/tag/index.astro",
    "./template/pages/tag/[tag].astro": "./src/template/pages/tag/[tag].astro",
    "./template/pages/404.astro": "./src/template/pages/404.astro",
    "./template/pages/rss.xml.ts": "./src/template/pages/rss.xml.ts",
    "./template/pages/robots.txt.ts": "./src/template/pages/robots.txt.ts",
    "./pure": "./src/pure/index.ts",
    "./pure/advanced": "./src/pure/advanced.ts",
    "./pure/basic": "./src/pure/basic.ts",
    "./pure/libs": "./src/pure/libs.ts",
    "./pure/pages": "./src/pure/pages.ts",
    "./pure/user": "./src/pure/user.ts",
    "./pure/utils": "./src/pure/utils.ts"
  },
  "bin": {
    "papyrus-content": "scripts/content-outline.mjs",
    "papyrus-logo": "scripts/create-logo-svg.mjs",
    "papyrus-mobile-icons": "scripts/create-mobile-icons.mjs",
    "papyrus-manifest": "scripts/create-webmanifest.mjs",
    "papyrus-theme": "scripts/theme-profile.mjs",
    "papyrus-post-date": "scripts/post-date.mjs",
    "papyrus-compress": "scripts/compress-images.mjs",
    "papyrus-cover": "scripts/create-cover-svg.mjs",
    "papyrus-card-cover": "scripts/create-card-cover.mjs",
    "papyrus-llms": "scripts/generate-llms.mjs",
    "papyrus-ai-indexes": "scripts/generate-ai-indexes.mjs",
    "papyrus-ai-validate": "scripts/validate-ai-metadata.mjs",
    "papyrus-tag-rss": "scripts/generate-tag-rss.mjs",
    "papyrus-check-links": "scripts/check-built-links.mjs",
    "papyrus-serve-static": "scripts/serve-static.py",
    "papyrus-cv-export": "scripts/export-cv.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src",
    "scripts",
    "examples",
    "public",
    "docs"
  ],
  "scripts": {
    "check": "astro check",
    "build": "pnpm run cv:export && pnpm run build:llms && pnpm run ai:indexes -- src/content/posts public/ai ${SITE_URL:-https://papyrus.marcelofelix.com} public/demo/site-data.json && pnpm run rss:tags && astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "cv:export": "node scripts/export-cv.mjs src/data/profile.toml public/cv/profile",
    "cv:check": "node scripts/export-cv.mjs src/data/profile.toml public/cv/profile --check",
    "precommit": "pnpm run cv:export",
    "build:llms": "node scripts/generate-llms.mjs src/content/posts public ${SITE_URL:-https://papyrus.marcelofelix.com} src/pages/docs",
    "logo": "node scripts/create-logo-svg.mjs --twinkle public/logo.svg && node scripts/create-logo-svg.mjs --twinkle public/favicon.svg",
    "mobile-icons": "node scripts/create-mobile-icons.mjs",
    "manifest": "node scripts/create-webmanifest.mjs",
    "theme": "node scripts/theme-profile.mjs",
    "content:outline": "node scripts/content-outline.mjs",
    "post:date": "node scripts/post-date.mjs",
    "compress": "node scripts/compress-images.mjs",
    "cover": "node scripts/create-cover-svg.mjs",
    "card-cover": "node scripts/create-card-cover.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "ai:indexes": "node scripts/generate-ai-indexes.mjs",
    "ai:validate": "node scripts/validate-ai-metadata.mjs",
    "rss:tags": "node scripts/generate-tag-rss.mjs",
    "verify:a4": "node .agents/scripts/verify-a4-cv.mjs",
    "verify:assets": "node .agents/scripts/verify-assets.mjs",
    "verify:theme": "node .agents/scripts/verify-theme.mjs",
    "verify:content": "node .agents/scripts/verify-content-model.mjs",
    "verify:config": "node .agents/scripts/verify-config-loader.mjs",
    "verify:features": "node .agents/scripts/verify-features.mjs",
    "verify:cv": "node .agents/scripts/verify-cv-data.mjs",
    "verify:ats": "node .agents/scripts/verify-ats-resume.mjs",
    "verify:ai": "node .agents/scripts/verify-ai-artifacts.mjs",
    "verify:package": "node .agents/scripts/verify-package-covers.mjs",
    "verify:pure-parity": "node .agents/scripts/verify-pure-parity.mjs",
    "verify:compress": "node .agents/scripts/verify-compress-workflow.mjs",
    "verify:date": "node .agents/scripts/verify-date-workflow.mjs",
    "verify:deps": "node .agents/scripts/verify-dependencies.mjs",
    "verify:release": "node .agents/scripts/verify-release-readiness.mjs",
    "verify:readme": "node .agents/scripts/verify-readme-scope.mjs",
    "verify:docs": "node .agents/scripts/verify-docs-structure.mjs",
    "verify:demo": "node .agents/scripts/verify-demo-coverage.mjs",
    "verify:public-content": "node .agents/scripts/verify-public-content.mjs",
    "verify:markdown": "node .agents/scripts/verify-markdown-demo.mjs",
    "verify:lighthouse": "node .agents/scripts/verify-lighthouse.mjs",
    "verify:responsive": "node .agents/scripts/verify-responsive-screenshots.mjs",
    "verify:docker": "node .agents/scripts/verify-docker.mjs",
    "verify:browser": "node .agents/scripts/verify-browser.mjs",
    "check:links": "node scripts/check-built-links.mjs",
    "audit:status": "node .agents/scripts/audit-status.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro-pure": "^1.4.6",
    "hastscript": "^9.0.1",
    "mermaid": "^11.16.0",
    "rehype-callouts": "^2.2.0",
    "satori": "^0.26.0",
    "smol-toml": "^1.7.0"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/sitemap": "^3.7.2",
    "@pagefind/default-ui": "^1.5.2",
    "astro": "^7.0.4",
    "lighthouse": "^13.4.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "wrangler": "4.106.0"
  }
}
