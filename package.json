    "./PapyrusCvLinks.astro": "./src/components/PapyrusCvLinks.astro",
    "./PapyrusCvSections.astro": "./src/components/PapyrusCvSections.astro",
    "./PapyrusCvExportActions.astro": "./src/components/PapyrusCvExportActions.astro",
    "./PapyrusCvA4Page.astro": "./src/components/PapyrusCvA4Page.astro",
    "./PapyrusJekyllCvPage.astro": "./src/components/PapyrusJekyllCvPage.astro",
    "./PapyrusProfilePage.astro": "./src/components/PapyrusProfilePage.astro",
    "./PapyrusAiMetadata.astro": "./src/components/PapyrusAiMetadata.astro",
    "./template/pages/index.astro": "./src/template/pages/index.astro",
    "./template/pages/about.astro": "./src/template/pages/about.astro",
    "./template/pages/posts/index.astro": "./src/template/pages/posts/index.astro",
    "./template/pages/posts/timeline.astro": "./src/template/pages/posts/timeline.astro",
    "./template/pages/posts/[...slug].astro": "./src/template/pages/posts/[...slug].astro",
    "./template/pages/projects.astro": "./src/template/pages/projects.astro",
    "./template/pages/profile/index.astro": "./src/template/pages/profile/index.astro",
    "./template/pages/profile/print.astro": "./src/template/pages/profile/print.astro",
    "./template/pages/profile/ast.astro": "./src/template/pages/profile/ast.astro",
    "./template/pages/collections.astro": "./src/template/pages/collections.astro",
    "./template/pages/collections/[slug].astro": "./src/template/pages/collections/[slug].astro",
    "./template/pages/collections/[collection]/[...slug].astro": "./src/template/pages/collections/[collection]/[...slug].astro",
    "./template/pages/search.astro": "./src/template/pages/search.astro",
