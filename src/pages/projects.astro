---
import { readFile } from "node:fs/promises";
import { PapyrusBaseLayout, PapyrusProjectList } from "../components";
import { demoNav, demoSocialLinks } from "../data/demo-nav";

const siteData = JSON.parse(await readFile("public/demo/site-data.json", "utf8")) as {
  projects: Parameters<typeof PapyrusProjectList>[0]["projects"];
};
---

<PapyrusBaseLayout
  title="Projects"
  description="Project list page for pinned projects, repository metadata, and explicit project links."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <section class="papyrus-hero">
    <h1>Projects</h1>
    <p class="papyrus-description">The Papyrus demo keeps projects focused on the two public repos readers need: the reusable theme package and the starter template.</p>
  </section>

  <section class="papyrus-section">
    <h2>Project cards</h2>
    <p>Projects come from structured site data, so homepage cards, the project index, and generated metadata can describe the same items without duplicating copy.</p>
    <PapyrusProjectList projects={siteData.projects} />
  </section>

  <section class="papyrus-section">
    <h2>Where projects live</h2>
    <p>Project cards read from site data, so the homepage, project index, and generated metadata can reuse the same titles, descriptions, tags, and links.</p>
    <p>Edit the project list in <code>src/data/projects.toml</code>. The template keeps that data close to the content so a site does not need custom card code for normal project pages.</p>
  </section>
</PapyrusBaseLayout>
