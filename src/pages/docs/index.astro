---
import { getCollection } from "astro:content";
import { PaperBaseLayout, PaperContentIndex, PaperLinkPreview, PaperSectionMenu } from "../../components";
import { demoNav, demoSocialLinks } from "../../data/demo-nav";
import { buildDocIndex, postDocIndexItem, publishedPosts, type PaperDocIndexItem } from "../../utils";

const docsIndex = (await getCollection("docs")).find(entry => entry.id.replace(/\.(md|mdx)$/i, "") === "index");
const docSections = docsIndex?.data.sections ?? [];
const docsDescription = docsIndex?.data.description ?? "Package docs for installing, composing, and extending papyrus without copying a full theme into every site.";
const explicitDocs: PaperDocIndexItem[] = [
  {
    title: "Feature map",
    href: "/docs/feature-map/",
    description: "Route-by-route guide to public Papyrus features.",
    section: "references",
    order: 20,
  },
  {
    title: "Post metadata display",
    href: "/metadata-demo/",
    description: "Post layout reference for published dates, updated dates, reading time, tags, canonical URLs, and feature toggles.",
    section: "references",
    order: 25,
  },
  {
    title: "Generated content structure",
    href: "/docs/content-structure/",
    description: "Nested Markdown folders, folder metadata, stable slugs, public outlines, and hidden-content boundaries.",
    section: "authoring",
    order: 30,
  },
  {
    title: "AI and mobile readiness",
    href: "/docs/ai-mobile/",
    description: "Generated AI metadata, content indexes, responsive primitives, and mobile authoring guidance.",
    section: "references",
    order: 50,
  },
  {
    title: "Deploy Papyrus",
    href: "/docs/deploy/",
    description: "Local preview, static hosting checks, and subdirectory deploy guidance for a Papyrus site.",
    section: "references",
    order: 60,
  },
  {
    title: "Feature config",
    href: "/docs/features/",
    description: "Grouped toggles for search, RSS, share, TOC, source actions, stats, and adjacent links.",
    section: "start",
    order: 20,
  },
  {
    title: "Markdown code guide",
    href: "/docs/code-demo/",
    description: "Markdown code fences with titles, line highlights, diff styling, callouts, tables, diagrams, and media.",
    section: "authoring",
    order: 10,
  },
];
const postDocs = publishedPosts(await getCollection("posts"))
  .map(post => postDocIndexItem(post))
  .filter((item): item is PaperDocIndexItem => Boolean(item));
const docs = buildDocIndex(docSections, [...explicitDocs, ...postDocs]);

const sections = [
  { title: "Index", href: "#index" },
  { title: "Theme profiles", href: "#theme-profiles" },
  { title: "Markdown", href: "#markdown" },
  { title: "AI metadata", href: "#ai-metadata" },
  { title: "Content model", href: "#content-model" },
];
---

<PaperBaseLayout
  title="papyrus docs"
  description={docsDescription}
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <PaperSectionMenu sections={sections} />

  <section class="paper-hero">
    <h1>Docs</h1>
    <p class="paper-description">{docsDescription}</p>
  </section>

  <section id="index" class="paper-section">
    <h2>Index</h2>
    <PaperContentIndex items={docs} />
  </section>

  <section id="theme-profiles" class="paper-section">
    <h2>Theme profiles</h2>
    <p>Each theme profile defines one light token set and one dark token set. Runtime mode defaults to system, while the default color profile is Gruvbox and the default font profile is readable. Included profiles are Catppuccin, Tokyo Night, Kanagawa, Rosé Pine, Everforest, Dracula, Gruvbox, Nord, and Pure.</p>
    <pre><code>{`:root[data-paper-theme="custom"] {
  --paper-bg: #fbf7ef;
  --paper-fg: #1f2933;
  --paper-muted: #6b7280;
  --paper-panel: #ffffff;
  --paper-border: #d8d0bf;
  --paper-accent: #7c3aed;
  --paper-code-bg: #f4efe5;
  --paper-code-fg: #111827;
  --paper-theme-color: #fbf7ef;
  --paper-font-sans: "Atkinson Hyperlegible", system-ui, sans-serif;
  --paper-font-mono: "Fira Code", ui-monospace, monospace;
}

:root[data-paper-theme="custom"].dark,
html[data-paper-theme="custom"].dark {
  --paper-bg: #111827;
  --paper-fg: #f9fafb;
  --paper-muted: #cbd5e1;
  --paper-panel: #1f2937;
  --paper-border: #374151;
  --paper-accent: #c4b5fd;
  --paper-code-bg: #0f172a;
  --paper-code-fg: #f8fafc;
  --paper-theme-color: #111827;
}`}</code></pre>
    <p>Use <code>pnpm papyrus-theme list</code> to inspect installed profiles and <code>pnpm papyrus-theme validate</code> to check that every profile file has the required light/dark selectors and tokens.</p>
  </section>

  <section id="markdown" class="paper-section">
    <h2>Markdown</h2>
    <p>The package owns markdown presentation for plain Astro/Shiki code blocks, alerts, task lists, tables, Mermaid blocks, artifact cards, and optional TOC rendering.</p>
    <PaperLinkPreview
      href="/docs/code-demo/"
      title="Markdown code guide"
      description="Open the Markdown guide to review code, alerts, diagrams, artifact links, and Markdown behavior."
      site="papyrus docs"
    />
  </section>

  <section id="ai-metadata" class="paper-section">
    <h2>AI metadata</h2>
    <p>Post pages can emit JSON-LD, canonical URLs, source Markdown links, copy-source actions, copy-citation actions, and generated agent indexes.</p>
    <PaperLinkPreview
      href="/docs/ai-mobile/"
      title="AI and mobile readiness"
      description="See generated metadata, AI indexes, responsive defaults, and mobile authoring guidance."
      site="papyrus docs"
    />
  </section>

  <section id="content-model" class="paper-section">
    <h2>Content model</h2>
    <p>Consuming sites keep content and config. papyrus provides components and helpers for nested posts, folder tags, stable slugs, generated docs indexes, pinned posts, project cards, and profile/CV pages.</p>
    <p>The docs index follows the Starlight-style shape: section metadata lives in <code>src/content/docs/index.md</code>, docs entries use explicit <code>order</code> values, and posts can opt into docs with <code>docs</code> frontmatter because docs and posts are built from the same content source.</p>
  </section>
</PaperBaseLayout>
