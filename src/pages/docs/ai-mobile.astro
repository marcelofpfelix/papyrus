---
import { PaperBaseLayout } from "../../components";
import { demoNav, demoSocialLinks } from "../../data/demo-nav";
import { withBase } from "../../utils/withBase";


const aiPrimitives = [
  "Package-level llms.txt and llms-full.txt generation for agent-readable site summaries.",
  "Static RSS feeds per tag.",
  "Static JSON indexes for posts, tags, projects, notes, and CV summary data.",
  "Static graph data export connecting posts, tags, projects, notes, and CV sections.",
  "Stable machine IDs in generated JSON indexes, graph nodes, graph edges, and search records.",
  "Reusable static search index for local agents.",
  "Content graph with search, type filters, node focus, neighbor dimming, and focused connection details.",
  "Build-time validation for required post, project, note, and CV index fields.",
  "Per-post JSON-LD metadata component for BlogPosting and other schema.org types.",
  "Post layout support for canonical URL, source Markdown URL, author metadata, copy Markdown, and copy citation.",
];

const aiExtensionIdeas = [
  "Add extra source links when a post depends on diagrams, notebooks, or external datasets.",
  "Add JSON-LD types for people, projects, software source code, or breadcrumbs on site-specific pages.",
  "Generate backlinks or related posts from Markdown links when the content model needs a knowledge graph.",
  "Store explicit license metadata for images, code snippets, and diagrams when licensing matters.",
  "Publish diagram source beside rendered SVG output for Mermaid, PlantUML, or Excalidraw workflows.",
];

const mobilePrimitives = [
  "Safe-area padding for the page shell on phones with notches or rounded display edges.",
  "44px coarse-pointer hit targets for core icon, copy, post action, tag, TOC, and back-to-top controls.",
  "Responsive post lists with stable cover dimensions and compact metadata.",
  "Collapsible table of contents and back-to-top controls designed for small screens.",
  "Image, SVG, and Mermaid zoom behavior that works with touch input.",
  "Reduced-motion handling for cursor, logo, header, dropdown, and page-transition effects.",
  "Profile and CV routes that share one data source across web, timeline, and print layouts.",
  "Static Pagefind search and generated tag pages, so mobile search does not require a server.",
];

const mobileAuthoringTips = [
  "Keep post descriptions short enough to scan in list views.",
  "Prefer real cover images or generated covers with stable aspect ratios.",
  "Use headings in order so the mobile table of contents remains useful.",
  "Put large diagrams behind Mermaid or artifact links instead of inline screenshots when possible.",
  "Preview layout-heavy changes on desktop and phone-sized screens before publishing.",
];
---

<PaperBaseLayout
  title="AI and mobile readiness"
  description="AI metadata, generated indexes, and mobile-ready defaults in a Papyrus site."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <section class="paper-hero">
    <h1>AI and mobile readiness</h1>
    <p class="paper-description">Papyrus ships useful agent-readable metadata, generated indexes, and responsive UI defaults for small content sites.</p>
  </section>

  <section class="paper-section">
    <h2>AI-first primitives</h2>
    <ul>
      {aiPrimitives.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      Generated files: <a href={withBase("/llms.txt")}>llms.txt</a>, <a href={withBase("/llms-full.txt")}>llms-full.txt</a>, <a href={withBase("/rss/tags/ai.xml")}>#ai RSS</a>, <a href={withBase("/ai/posts.json")}>posts.json</a>, <a href={withBase("/ai/tags.json")}>tags.json</a>, <a href={withBase("/ai/projects.json")}>projects.json</a>, <a href={withBase("/ai/notes.json")}>notes.json</a>, <a href={withBase("/ai/cv.json")}>cv.json</a>, and <a href={withBase("/ai/graph.json")}>graph.json</a>.
    </p>
  </section>

  <section class="paper-section">
    <h2>Site-specific AI extensions</h2>
    <ul>
      {aiExtensionIdeas.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="paper-section">
    <h2>Mobile-first primitives</h2>
    <ul>
      {mobilePrimitives.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="paper-section">
    <h2>Mobile authoring tips</h2>
    <ul>
      {mobileAuthoringTips.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</PaperBaseLayout>
