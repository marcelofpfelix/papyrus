---
import { readFile } from "node:fs/promises";
import { PaperBaseLayout, PaperContentIndex, PaperLinkPreview } from "../../components";
import { demoNav, demoSocialLinks } from "../../data/demo-nav";

interface ContentIndexItem {
  title: string;
  href?: string;
  description?: string;
  children?: ContentIndexItem[];
}


const outlinePath = "public/demo/content-structure.md";
const outline = await readFile(outlinePath, "utf8");

function generatedHref(path: string) {
  return /\.mdx?$/.test(path) ? "/demo/content-tree/" + path : undefined;
}

function parseContentOutline(markdown: string) {
  const items: ContentIndexItem[] = [];
  const stack: Array<{ depth: number; item: ContentIndexItem }> = [];
  let collectionTitle = "Generated content structure";
  let collectionDescription = "A generated map of nested content and folder metadata.";

  for (const line of markdown.split("\n")) {
    const collectionMatch = line.match(/^Collection: (.+)$/);
    if (collectionMatch) {
      collectionTitle = collectionMatch[1];
      continue;
    }

    const descriptionMatch = line.match(/^Description: (.+)$/);
    if (descriptionMatch) {
      collectionDescription = descriptionMatch[1];
      continue;
    }

    const itemMatch = line.match(/^(\s*)- ([^:]+?)(?:: (.+))?$/);
    if (itemMatch) {
      const depth = itemMatch[1].length / 2;
      const path = itemMatch[2].trim();
      const title = itemMatch[3]?.trim() || path;
      const item: ContentIndexItem = { title, href: generatedHref(path) };

      if (depth === 0) {
        items.push(item);
      } else {
        const parent = [...stack].reverse().find((entry) => entry.depth === depth - 1)?.item;
        if (parent) {
          parent.children ??= [];
          parent.children.push(item);
        } else {
          items.push(item);
        }
      }

      stack.splice(depth);
      stack[depth] = { depth, item };
      continue;
    }

    const nestedDescriptionMatch = line.match(/^(\s+)_([^_].+)_$/);
    if (nestedDescriptionMatch) {
      const depth = Math.max((nestedDescriptionMatch[1].length / 2) - 1, 0);
      const target = stack[depth]?.item;
      if (target) target.description = nestedDescriptionMatch[2];
    }
  }

  return { collectionTitle, collectionDescription, items };
}

const content = parseContentOutline(outline);
---

<PaperBaseLayout
  title="Generated content structure"
  description="How Papyrus turns nested Markdown folders and folder metadata into a readable public content index."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <section class="paper-hero">
    <h1>Generated content structure</h1>
    <p class="paper-description">Use folder metadata when a site needs nested notes, guides, or knowledge-base pages without turning source paths into fragile public URLs.</p>
  </section>

  <section class="paper-section">
    <h2>What gets generated</h2>
    <p>Papyrus can read a folder tree, combine explicit frontmatter with folder-level labels, and render a public index that still feels hand-authored. The fixture below is generated from <code>{outlinePath}</code>, which itself was produced from Markdown files under <code>public/demo/content-tree</code>.</p>
    <PaperContentIndex items={content.items} />
  </section>

  <section class="paper-section">
    <h2>How to use it</h2>
    <p>Keep canonical slugs in frontmatter when a page has a permanent URL. Use folders for organization, inherited tags, and section labels. This lets authors move files while the published route, RSS item, search result, and AI metadata stay stable.</p>
    <pre class="paper-docs-raw"><code>pnpm papyrus-content-outline public/demo/content-tree public/demo/content-structure.md</code></pre>
    <ul>
      <li>Use folder names for broad groups such as <code>guides</code>, <code>notes</code>, or <code>reference</code>.</li>
      <li>Use an index file or folder metadata to name a section for readers.</li>
      <li>Mark draft, private, or internal posts with <code>hidden: true</code> when they need a direct route but should stay out of public lists, feeds, sitemaps, search, and AI exports. Add explicit <code>robots</code> frontmatter only when the direct page itself should be blocked from indexing.</li>
      <li>Generate the outline during build when the content tree is meant to be visible to readers.</li>
    </ul>
  </section>

  <section class="paper-section">
    <h2>Public boundary</h2>
    <p>This route is public because the demo content tree is a public fixture for content-outline generation. User-facing docs live in rendered routes such as <code>src/pages/docs</code> or posts that opt into the docs index with <code>docs</code> frontmatter. Development-only notes stay under <code>docs/</code> and are not linked from the demo navigation unless they are intentionally rewritten as user documentation.</p>
  </section>

  <section class="paper-section">
    <h2>Source artifact</h2>
    <PaperLinkPreview
      href="/demo/content-structure.md"
      title="Generated markdown outline"
      description="Public Markdown outline generated from nested content folders and folder metadata."
      site="papyrus fixture"
    />
  </section>
</PaperBaseLayout>
