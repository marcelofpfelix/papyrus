---
import { PapyrusBaseLayout, PapyrusContentIndex, PapyrusSectionMenu } from "../../components";
import { demoNav, demoSocialLinks } from "../../data/demo-nav";


const sections = [
  { title: "Feature map", href: "#feature-map" },
  { title: "How to use it", href: "#how-to-use-it" },
];

const features = [
  {
    title: "Install and configure Papyrus",
    href: "/posts/install-configure-papyrus/",
    description: "Template-first guide for starting from papyrus-template, editing TOML config, adding posts, profile data, and asset overrides.",
  },
  {
    title: "Layout, header, footer, and theme controls",
    href: "/",
    description: "Home uses the base layout, logo home link, package nav, footer social links, powered-by links, and theme/font controls.",
  },
  {
    title: "Post layout and actions",
    href: "/metadata-demo/",
    description: "Post pages show cover images, dates, tags, reading time, adjacent links, source/copy/share actions, table of contents, and optional back links in one reusable layout.",
  },
  {
    title: "Post metadata display",
    href: "/metadata-demo/",
    description: "Published date, updated date, reading time, tags, canonical URL, and post-feature toggles rendered through the post layout.",
  },
  {
    title: "Markdown authoring guide",
    href: "/docs/code-demo/",
    description: "Pure-style Astro/Shiki code blocks, line numbers, language labels, copy buttons, diff/highlight notation, console fences, alerts, task lists, tables, Mermaid SVG, artifacts, and zoom hooks.",
  },
  {
    title: "Posts index and tags",
    href: "/posts/",
    description: "Pinned ordering, last-post helpers, list-only archive view, tag links, compact metadata, timeline link, and small covers; alternate post-list views are documented in the package-shape post.",
  },
  {
    title: "Search and tag filters",
    href: "/search/",
    description: "Search works with tag filters, standalone tag pages, and generated RSS feeds for individual tags.",
  },
  {
    title: "CV/profile templates",
    href: "/profile/",
    description: "Public profile implementation with resume, timeline, projects, A4 links, and normalized CV data.",
  },
  {
    title: "Profile print route",
    href: "/profile/print/",
    description: "Printable profile route using the same CV data and layout controls as the web profile.",
  },
  {
    title: "Projects and GitHub cards",
    href: "/projects/",
    description: "Pinned projects, project list cards, and Pure-inspired GitHub repository preview cards.",
  },
  {
    title: "Feature flags and plugin contract",
    href: "/docs/features/",
    description: "Configurable feature flags, comment-system decision, plugin capability cards, and a typed plugin configuration pattern.",
  },
  {
    title: "Content structure helpers",
    href: "/docs/content-structure/",
    description: "Nested folders, folder metadata, folder-derived tags, stable slugs, and generated docs/content outlines.",
  },
  {
    title: "Deploy and local preview",
    href: "/docs/deploy/",
    description: "Local dev, production preview, static hosting checks, base-path deploys, and deploy guidance without doing a deploy.",
  },
  {
    title: "AI and mobile readiness",
    href: "/docs/ai-mobile/",
    description: "Generated metadata, AI indexes, responsive primitives, and mobile authoring guidance.",
  },
];
---

<PapyrusBaseLayout
  title="Feature map"
  description="Route-by-route guide to public Papyrus features."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <PapyrusSectionMenu sections={sections} />

  <section class="papyrus-hero">
    <h1>Feature map</h1>
    <p class="papyrus-description">Every public feature has a route that shows how a consuming site can use it. Start here when exploring Papyrus.</p>
  </section>

  <section id="feature-map" class="papyrus-section">
    <h2>Feature map</h2>
    <PapyrusContentIndex items={features} />
  </section>

  <section id="how-to-use-it" class="papyrus-section">
    <h2>How to use it</h2>
    <p>Use this map as an orientation page when adding Papyrus to another Astro site. Each linked route shows the content, component, or generated artifact in context.</p>
    <p>The public Papyrus site focuses on reusable routes, content patterns, and generated artifacts. Repository-only implementation notes stay outside the visitor-facing docs.</p>
  </section>
</PapyrusBaseLayout>
