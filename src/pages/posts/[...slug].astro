---
import { getCollection, render } from "astro:content";
import PapyrusPostLayout from "../../layouts/PapyrusPostLayout.astro";
import { demoNav, demoSocialLinks } from "../../data/demo-nav";
import { getPostCollections } from "../../utils/collections";
import { getAdjacentPosts, postSlug, postTags, publishedPosts, readingTime, routablePosts } from "../../utils/posts";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const adjacentPosts = publishedPosts(allPosts);
  const collections = await getPostCollections("src/content/posts", allPosts);
  const posts = routablePosts(allPosts);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      adjacent: getAdjacentPosts(adjacentPosts, post.id),
      postCollections: collections.filter(collection =>
        collection.posts.some(collectionPost => postSlug(collectionPost) === postSlug(post))
      ),
    },
  }));
}

const { post, adjacent, postCollections = [] } = Astro.props;
const { Content, headings } = await render(post);
const slug = postSlug(post);
const sourcePath = post.filePath?.replace(/^.*?(src\/content\/posts\/)/, "$1") ?? `src/content/posts/${post.id}`;
const sourceLinkUrl = `https://github.com/marcelofpfelix/papyrus/blob/main/${sourcePath}`;
const sourceUrl = `https://raw.githubusercontent.com/marcelofpfelix/papyrus/main/${sourcePath}`;
---

<PapyrusPostLayout
  title={post.data.title}
  description={post.data.description}
  siteTitle="papyrus"
  pubDatetime={post.data.pubDatetime}
  modDatetime={post.data.modDatetime}
  cover={post.data.cover}
  tags={postTags(post)}
  readingTime={readingTime(post.body)}
  headings={headings}
  showToc={true}
  canonicalUrl={`/posts/${slug}/`}
  sourceUrl={sourceUrl}
  sourceLinkUrl={sourceLinkUrl}
  robots={post.data.robots}
  previous={adjacent.previous}
  next={adjacent.next}
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <Content />

  {
    postCollections.length > 0 && (
      <Fragment slot="after">
        <section class="papyrus-collection-membership">
          <p class="papyrus-collection-note">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
            </svg>
            <span>Part of{" "}</span>
            {postCollections.map((collection, index) => (
              <>
                {index > 0 && (index === postCollections.length - 1 ? " and " : ", ")}
                <a href={collection.href}>{collection.name}</a>
              </>
            ))}
            .
          </p>
        </section>
      </Fragment>
    )
  }
</PapyrusPostLayout>
