---
import { PaperArchiveList, PaperBaseLayout } from "../../components";
import { demoNav, demoSocialLinks } from "../../data/demo-nav";
import { demoPosts } from "../../data/demo-posts";
import { publishedPosts } from "../../utils/posts";

const posts = publishedPosts(demoPosts);

---

<PaperBaseLayout
  title="Timeline"
  description="Chronological archive view for Papyrus posts."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <section class="paper-hero">
    <h1>Timeline</h1>
    <p class="paper-description">A timeline gives readers a compact chronological archive without changing the primary posts index. Papyrus can keep the index focused and link to this view for readers who want everything by date.</p>
  </section>

  <section class="paper-section">
    <h2>All posts by date</h2>
    <PaperArchiveList posts={posts} />
  </section>
</PaperBaseLayout>
