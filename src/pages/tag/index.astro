---
import { PaperBaseLayout, PaperTagList } from "../../components";
import { demoNav, demoSocialLinks } from "../../data/demo-nav";
import { demoPosts } from "../../data/demo-posts";
import { getAllTags, postTags, publishedPosts } from "../../utils/posts";
import { withBase } from "../../utils/withBase";

const posts = publishedPosts(demoPosts);
const tags = getAllTags(posts);
const counts = Object.fromEntries(
  tags.map(tag => [tag, posts.filter(post => postTags(post).includes(tag)).length])
);
---

<PaperBaseLayout
  title="Tags"
  description="Browse Papyrus posts by tag."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <section class="paper-hero">
    <p class="paper-post-back">
      <a href={withBase("/posts/")}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <span>Back</span>
      </a>
    </p>
    <h1>Tags</h1>
    <p class="paper-description">Tags provide focused entry points for readers, generated tag pages, and optional per-tag RSS feeds without requiring a separate category system.</p>
  </section>

  <section class="paper-section">
    <PaperTagList tags={tags} counts={counts} />
  </section>
</PaperBaseLayout>
