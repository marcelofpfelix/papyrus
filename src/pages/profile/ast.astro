---
import { cvSections, printProfileLinks, profile } from "../../data/profile";
import { PapyrusCvActions } from "../../components";
import { githubSourceUrl, loadPapyrusConfig } from "../../config";
import { compactDurationLabel, profileLinkKindLabel } from "../../utils/cv-profile-data";
import { shouldShowCvItemTitle } from "../../utils/cv";
import { withBase } from "../../utils/withBase";
import "../../styles/papyrus.css";
import "../../styles/cv-print.css";

const site = await loadPapyrusConfig();
const currentCvHref = profile.canonicalCv;
const cvMarkdownHref = withBase("/cv/profile.md");
const profileSourceLinks = [
  { label: "TOML", href: githubSourceUrl(site, "src/data/profile.toml") },
  { label: "JSON", href: githubSourceUrl(site, "public/cv/profile.json") },
  { label: "Markdown", href: githubSourceUrl(site, "public/cv/profile.md") },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
const profileVersionLinks = [
  { label: "Modern", href: withBase("/profile/print/") },
  { label: "Classic", href: withBase("/profile/ast/") },
];
type ContactItem = {
  label: string;
  value: string;
  href?: string;
  emailParts?: {
    user: string;
    domain: string;
    domainParts: string[];
  };
};

const contactItems: ContactItem[] = [
  ...printProfileLinks
    .map(link => ({
      label: profileLinkKindLabel(link),
      value: link.href ?? link.label,
      href: link.href,
      emailParts: link.emailParts,
    })),
];

const profileSectionIds = new Set(["profile", "about", "summary"]);
const summarySections = cvSections.filter(section => profileSectionIds.has(section.id));
const contentSections = cvSections.filter(section => !profileSectionIds.has(section.id));
const normalizedSummary = profile.summary.trim();
const summaryItems = summarySections
  .flatMap(section => section.groups)
  .flatMap(group => group.items)
  .filter(item => item.description && item.description.trim() !== normalizedSummary);
const showSummaryParagraph = Boolean(
  normalizedSummary && !summaryItems.some(item => item.description?.trim().startsWith(normalizedSummary))
);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`ATS-friendly printable CV for ${profile.name}`} />
    <link rel="icon" href={profile.favicon} />
    <title>{profile.name} - ATS CV</title>
  </head>
  <body>
    <PapyrusCvActions
      backHref={withBase("/profile/")}
      print
      markdownHref={cvMarkdownHref}
      shareText={profile.headline}
      sourceLinks={profileSourceLinks}
      versionLinks={profileVersionLinks}
    />

    <main class="resume" aria-label={`${profile.name} ATS-friendly CV`}>
      <header class="resume-header">
        <h1>{profile.name}</h1>
        {profile.headline && <p class="headline">{profile.headline}</p>}
        <ul class="contact-list">
          {contactItems.map(item => (
            <li>
              <strong>{item.label}:</strong>{" "}
              {item.emailParts ? (
                <span class="email-parts">
                  <span>{item.emailParts.user}</span><span class="email-at" aria-hidden="true"></span><span>{item.emailParts.domainParts.join(".")}</span>
                </span>
              ) : item.href ? <a href={item.href}>{item.value}</a> : item.value}
            </li>
          ))}
        </ul>
      </header>

      <p class="resume-updated">
        You can always find this CV updated at <a href={currentCvHref}>{currentCvHref}</a>.
      </p>

      <section class="resume-section" aria-labelledby="summary-heading">
        <h2 id="summary-heading">Professional Summary</h2>
        {showSummaryParagraph && <p>{profile.summary}</p>}
        {summaryItems.map(item => (
          item.description && <div class="resume-description" set:html={item.description} />
        ))}
      </section>

      {contentSections.map(section => (
        <section class="resume-section" aria-labelledby={`${section.id}-heading`}>
          <h2 id={`${section.id}-heading`}>{section.title}</h2>
          {section.duration && <p class="section-meta">Total duration: {compactDurationLabel(section.duration)}</p>}
          {section.groups.map(group => (
            <article class="resume-entry">
              <header class="entry-header">
                {group.entity && <h3>{group.entity}</h3>}
              </header>
              {group.items.map(item => (
                <section class="resume-role">
                  {(shouldShowCvItemTitle(section, group, item) || item.location || item.dates || item.duration) && (
                    <header class="role-header">
                      {shouldShowCvItemTitle(section, group, item) && <h4>{item.title}</h4>}
                      {(item.location || item.dates || item.duration) && (
                        <p class="entry-meta">
                          {[
                            item.location,
                            item.dates,
                            compactDurationLabel(item.duration),
                          ].filter(Boolean).join(" | ")}
                        </p>
                      )}
                    </header>
                  )}
                  {item.description && <div class="resume-description" set:html={item.description} />}
                </section>
              ))}
            </article>
          ))}
        </section>
      ))}
      <footer>made with <a href="https://github.com/marcelofpfelix/papyrus">github.com/marcelofpfelix/papyrus</a></footer>
    </main>
  </body>
</html>

<style>
  @page {
    margin: 13mm;
    size: A4;
  }

  * {
    box-sizing: border-box;
  }

  body {
    color: #000;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10.5pt;
    line-height: 1.36;
    margin: 0;
  }

  a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .resume {
    background: #fff;
    box-shadow: 0 18px 42px rgb(0 0 0 / 0.16);
    margin: 0 auto 12mm;
    min-height: 297mm;
    padding: 14mm 15mm;
    width: min(210mm, calc(100% - 24px));
  }

  .resume-header {
    border-bottom: 2px solid #000;
    padding-bottom: 10px;
    text-align: center;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: 22pt;
    letter-spacing: 0;
    line-height: 1.1;
    margin-bottom: 5px;
  }

  .headline {
    font-weight: 700;
    margin-bottom: 8px;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 12px;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-list li {
    margin-bottom: 0;
  }

  .email-at::before {
    content: "＠";
  }

  @media print {
    .email-at::before {
      content: "@";
    }
  }

  .resume-section {
    border-bottom: 1px solid #c9c9c9;
    padding: 9px 0 7px;
  }

  .resume-updated {
    font-size: 9pt;
    margin: 8px auto 0;
    padding: 5px 8px;
    text-align: center;
    width: fit-content;
  }

  .resume-section:last-child {
    border-bottom: 0;
  }

  h2 {
    font-size: 12pt;
    letter-spacing: 0;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .entry-header,
  .role-header {
    align-items: baseline;
    display: flex;
    gap: 10px;
    justify-content: space-between;
  }

  h3 {
    font-size: 11pt;
    margin-bottom: 1px;
  }

  h4 {
    font-size: 10.5pt;
    margin-bottom: 1px;
  }

  .section-meta,
  .entry-meta,
  .entry-url {
    font-size: 9.5pt;
    margin-bottom: 4px;
  }

  .resume-entry,
  .resume-role {
    break-inside: avoid;
    margin-bottom: 7px;
    page-break-inside: avoid;
  }

  .resume-description,
  .resume-description :global(p),
  .resume-description :global(li) {
    margin-bottom: 3px;
  }

  .resume-description :global(ul) {
    margin: 0 0 4px;
    padding-left: 16px;
  }

  footer {
    color: #444;
    font-size: 8.5pt;
    margin-top: 12px;
    text-align: center;
  }

  @media print {
    .no-print {
      display: none;
    }

    .resume {
      box-shadow: none;
      margin: 0;
      min-height: 0;
      padding: 0;
      width: auto;
    }
  }
</style>
