---
import { PaperBaseLayout, PaperNotFound } from "../components";
import { demoNav, demoSocialLinks } from "../data/demo-nav";
import { demoPosts } from "../data/demo-posts";
import { postHref, postTags, publishedPosts, sortPosts } from "../utils/posts";

const staticItems = [
  {
    title: "Posts",
    description: "Primary post index with pinned guides, metadata, tags, RSS, and archive links.",
    href: "/posts/",
    tags: ["posts"],
  },
  {
    title: "Timeline",
    description: "Chronological archive view for readers who want every public post by date.",
    href: "/posts/timeline/",
    tags: ["posts", "timeline"],
  },
  {
    title: "Search",
    description: "Static Pagefind search with section, tag, and hidden-archive entry points.",
    href: "/search/",
    tags: ["search"],
  },
  {
    title: "Docs",
    description: "Install guide, feature map, authoring docs, content model, and generated metadata.",
    href: "/docs/",
    tags: ["docs"],
  },
  {
    title: "Content structure",
    description: "How Papyrus maps content into routes and metadata.",
    href: "/docs/content-structure/",
    tags: ["docs", "content"],
  },
  {
    title: "Projects",
    description: "Structured project cards shared by the homepage, project index, AI metadata, and graph export.",
    href: "/projects/",
    tags: ["projects"],
  },
  {
    title: "Profile",
    description: "TOML-driven profile, timeline, print CV, Markdown export, and JSON export routes.",
    href: "/profile/",
    tags: ["profile", "cv"],
  },
];
const postItems = sortPosts(publishedPosts(demoPosts)).map((post) => ({
  title: post.data.title,
  description: post.data.description,
  href: postHref(post),
  tags: postTags(post),
}));
const items = [...postItems, ...staticItems];
---

<PaperBaseLayout
  title="Page not found"
  description="Find a matching Papyrus page, post, tag, project, or documentation route."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <PaperNotFound
    items={items}
    description="The route may have moved or the URL may be incomplete. Search the generated page index or choose one of the closest matching posts, docs, projects, tags, or profile routes."
  />
</PaperBaseLayout>
