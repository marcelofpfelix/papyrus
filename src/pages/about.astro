---
import { PapyrusBaseLayout, PapyrusGithubCard, PapyrusLinkPreview } from "../components";
import { demoNav, demoSocialLinks } from "../data/demo-nav";

---

<PapyrusBaseLayout
  title="About"
  description="About page pattern for a Papyrus site, with a short introduction, profile link, and real-world usage example."
  siteTitle="papyrus"
  nav={demoNav}
  socialLinks={demoSocialLinks}
>
  <section class="papyrus-hero">
    <h1>About</h1>
    <p class="papyrus-description">A Papyrus about page should be short: introduce the site, link to the structured profile, and show one or two concrete examples instead of duplicating the post archive.</p>
  </section>

  <section class="papyrus-section">
    <h2>Profile flow</h2>
    <p>Keep this page short. Put structured career data in <code>src/data/profile.toml</code>, then link to the full profile, timeline, and printable CV routes.</p>
    <PapyrusLinkPreview
      href="/profile/"
      title="Profile"
      description="TOML-driven profile with resume, timeline, project, and printable CV views."
      site="papyrus docs"
    />
  </section>

  <section class="papyrus-section">
    <h2>Showcase</h2>
    <p><a href="https://marcelofelix.com">marcelofelix.com</a> is a real Papyrus site. It uses the theme package, keeps content in its own repository, and overrides only the data and assets that make the site personal.</p>
    <PapyrusGithubCard repo="marcelofpfelix/marcelofelix" description="Personal site built with Papyrus: Astro, Markdown posts, TOML profile data, Cloudflare Pages, and a small local codebase." fetchMetadata={false} />
  </section>
</PapyrusBaseLayout>
