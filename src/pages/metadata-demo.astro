---
import PaperPostLayout from "../layouts/PaperPostLayout.astro";
import { demoNav, demoSocialLinks } from "../data/demo-nav";
import { readingTime } from "../utils/posts";

const body = [
  "Use this route to check how PaperPostLayout presents a published date, an updated date, reading time, and tags when a post has changed after publication.",
  "A consuming site gets the same footer behavior by passing pubDatetime, modDatetime, tags, and readingTime to the post layout.",
];
---

<PaperPostLayout
  title="Post metadata display"
  description="Post layout reference for published date, updated date, reading time, and tags."
  siteTitle="papyrus"
  pubDatetime="2026-07-01T10:00:00.000Z"
  modDatetime="2026-07-03T12:00:00.000Z"
  tags={["authoring", "metadata"]}
  readingTime={readingTime(body.join("\n\n"))}
  canonicalUrl="/metadata-demo/"
  nav={demoNav}
  socialLinks={demoSocialLinks}
  features={{ sourceActions: false, share: false, postStats: false, adjacentPosts: false }}
>
  {body.map((paragraph) => <p>{paragraph}</p>)}
</PaperPostLayout>
