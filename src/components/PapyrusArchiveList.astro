---
import { formatPostDate, isScheduledPost, postDate, postHref, postPublishTimestamp } from "../utils/posts";
import PapyrusScheduledPostsRuntime from "./runtime/PapyrusScheduledPostsRuntime.astro";

interface PostItem {
  id: string;
  data: {
    title: string;
    slug?: string;
    pubDatetime?: Date | string;
    date?: Date | string;
  };
}

interface Props {
  posts: PostItem[];
  basePath?: string;
  openYearWindow?: number;
}

const { posts, basePath = "/posts", openYearWindow = 2 } = Astro.props;
const currentYear = new Date().getFullYear();
const firstCollapsedYear = currentYear - openYearWindow + 1;

function href(post: PostItem) {
  return postHref(post, basePath);
}

function yearOf(post: PostItem) {
  return postDate(post).getFullYear();
}

function dateOf(post: PostItem) {
  return formatPostDate(postDate(post));
}

function publishAt(post: PostItem) {
  return isScheduledPost(post) ? String(postPublishTimestamp(post)) : undefined;
}

const groups = Map.groupBy(posts, yearOf);
---

<div class="papyrus-archive-list">
  {
    Array.from(groups.entries()).map(([year, yearPosts]) => (
      <details class="papyrus-archive-year" open={year >= firstCollapsedYear} data-papyrus-archive-year>
        <summary>
          <h2>{year}</h2>
          <span data-papyrus-archive-count>{yearPosts.filter(post => !isScheduledPost(post)).length}</span>
        </summary>
        <ul>
          {yearPosts.map(post => (
            <li hidden={isScheduledPost(post)} data-papyrus-publish-at={publishAt(post)}>
              <time>{dateOf(post)}</time>
              <a href={href(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</div>
<PapyrusScheduledPostsRuntime />
