---
import type { PapyrusCvSection, PapyrusCvSectionOverrides } from "../utils/cv";

const { sections = [], sectionOverrides = {} } = Astro.props as {
  sections?: PapyrusCvSection[];
  sectionOverrides?: PapyrusCvSectionOverrides;
};

function overrideFor(section: PapyrusCvSection) {
  return sectionOverrides[section.id ?? section.title] ?? {};
}
---

<div class="papyrus-cv-sections">
  {sections.map((section) => {
    const override = overrideFor(section);
    if (override.hidden) return null;
    const variant = override.variant ?? "default";

    return (
    <section class:list={["papyrus-cv-section", `papyrus-cv-section--${variant}`]} id={section.id}>
      <h2><span aria-hidden="true">{override.icon ?? section.icon ?? "section"}</span>{override.title ?? section.title}</h2>
      {section.groups?.map((group) => (
        <article class="papyrus-cv-group">
          {group.title && (
            <div class="papyrus-cv-group-heading">
              {group.logo && <img src={group.logo} alt="" loading="lazy" />}
              <h3>
                {group.url ? <a href={group.url}>{group.title}</a> : group.title}
              </h3>
            </div>
          )}
          {group.items?.map((item) => (
            <div class="papyrus-cv-item">
              {item.title && <h4>{item.title}</h4>}
              {(item.dates || item.location) && (
                <p class="papyrus-cv-item-meta">
                  {[item.dates, item.location].filter(Boolean).join(" / ")}
                </p>
              )}
              {item.description && <p>{item.description}</p>}
            </div>
          ))}
        </article>
      ))}
    </section>
    );
  })}
</div>
