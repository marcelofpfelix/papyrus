---
interface Props {
  repo: string;
  description?: string;
  fetchMetadata?: boolean;
}

const { repo: repoRaw, description = "Waiting for api.github.com...", fetchMetadata = true } = Astro.props;
const repo = repoRaw.replace(/^https:\/\/github\.com\//, "");
const [owner, repoName] = repo.split("/");
---

<github-card class:list={["papyrus-github-preview", fetchMetadata && "loading"]} data-repo={repo} data-fetch-metadata={String(fetchMetadata)}>
  <a href={`https://github.com/${repo}`} target="_blank" rel="noreferrer">
    <header>
      <span class="papyrus-github-avatar" data-gh-avatar></span>
      <strong><span>{owner}</span><span>/</span><span>{repoName}</span></strong>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M15 21v-3.5a3.2 3.2 0 0 0-.9-2.5c3-.3 6.1-1.5 6.1-6.5a5 5 0 0 0-1.4-3.5 4.7 4.7 0 0 0-.1-3.4s-1.1-.4-3.6 1.3a12.2 12.2 0 0 0-6.2 0C6.4 1.7 5.3 2.1 5.3 2.1a4.7 4.7 0 0 0-.1 3.4 5 5 0 0 0-1.4 3.5c0 5 3.1 6.2 6.1 6.5a2.8 2.8 0 0 0-.8 1.7c-.7.3-2.5.8-3.6-1a2.6 2.6 0 0 0-1.9-1.3s-1.2 0-.1.7a3.3 3.3 0 0 1 1.4 1.8s.8 2.5 4.1 1.6V21"></path>
      </svg>
    </header>
    <p data-gh-description>{description}</p>
    {fetchMetadata && (
      <footer data-gh-meta hidden>
        <span>stars <b data-gh-stars></b></span>
        <span>forks <b data-gh-forks></b></span>
        <span data-gh-language></span>
        <span data-gh-license></span>
      </footer>
    )}
  </a>
</github-card>

<script>
  interface GithubProps {
    stargazers_count: number;
    forks: number;
    language: string | null;
    owner: { avatar_url: string };
    license?: { spdx_id: string };
    description: string | null;
  }

  class GithubCard extends HTMLElement {
    async connectedCallback() {
      const repo = this.dataset.repo;
      if (!repo || this.dataset.loaded || this.dataset.fetchMetadata === "false") return;
      this.dataset.loaded = "true";

      try {
        const response = await fetch(`https://api.github.com/repos/${repo}`, { referrerPolicy: "no-referrer" });
        if (!response.ok) throw new Error(`GitHub API ${response.status}`);
        const data = await response.json() as GithubProps;
        this.update("[data-gh-stars]", this.format(data.stargazers_count));
        this.update("[data-gh-forks]", this.format(data.forks));
        this.update("[data-gh-language]", data.language || "N/A");
        this.update("[data-gh-license]", data.license?.spdx_id || "N/A");
        this.update("[data-gh-description]", data.description || "Description not set");
        const avatar = this.querySelector<HTMLElement>("[data-gh-avatar]");
        if (avatar) avatar.style.backgroundImage = `url(${data.owner.avatar_url})`;
        const meta = this.querySelector<HTMLElement>("[data-gh-meta]");
        if (meta) meta.hidden = false;
        this.classList.remove("loading");
      } catch {
        this.update("[data-gh-description]", "GitHub metadata unavailable");
      }
    }

    format(value: number) {
      return Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(value);
    }

    update(selector: string, value: string) {
      const element = this.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }
  }

  if (!customElements.get("github-card")) customElements.define("github-card", GithubCard);
</script>
