---
import { getAssetPath, withBase } from "../utils/withBase";

interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  site?: string;
}

const { href, title, description = "", image, site } = Astro.props;
const resolvedHref = withBase(href);
const hostname = site ?? (() => {
  try {
    return new URL(href).hostname;
  } catch {
    return href;
  }
})();
---

<a class="papyrus-link-preview" href={resolvedHref}>
  {
    image && (
      <img src={getAssetPath(image)} alt="" loading="lazy" />
    )
  }
  <span>
    <strong>{title}</strong>
    {description && <small>{description}</small>}
    <em>{hostname}</em>
  </span>
</a>
