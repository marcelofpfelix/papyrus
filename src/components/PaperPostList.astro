---
import {
  formatPostDate,
  hasFreshUpdate,
  hasUpdatedDate,
  isNewPost,
  postHref,
  postTags,
  readingTime,
  tagHref,
  toTransitionName,
} from "../utils/posts";
import { getAssetPath } from "../utils/withBase";

interface PostItem {
  id: string;
  filePath?: string;
  body?: string;
  data: {
    title: string;
    description?: string;
    slug?: string;
    pubDatetime?: Date | string;
    modDatetime?: Date | string;
    date?: Date | string;
    pinned?: boolean | number;
    cover?: string;
    tags?: string[];
  };
}

interface Props {
  posts: PostItem[];
  basePath?: string;
  view?: "list" | "compact" | "cards";
  showTags?: boolean;
  showReadTime?: boolean;
  showFreshIndicators?: boolean;
  showUpdatedDateOnly?: boolean;
  showFirstTagWhenTagsHidden?: boolean;
  showPinnedText?: boolean;
  showFreshIndicatorText?: boolean;
}

const {
  posts,
  basePath = "/posts",
  view = "list",
  showTags = true,
  showReadTime = false,
  showFreshIndicators = true,
  showUpdatedDateOnly = false,
  showFirstTagWhenTagsHidden = false,
  showPinnedText = false,
  showFreshIndicatorText = true,
} = Astro.props;

function icon(name: string) {
  const icons: Record<string, string> = {
    calendar: `<rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path>`,
    clock: `<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path>`,
    pin: `<path d="m15 4 5 5-4 4v5l-2 2-5.5-5.5L4 19l-1-1 4.5-4.5L2 8l2-2h5z"></path>`,
    sparkles: `<path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"></path><path d="M19 14l.8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8L19 14z"></path><path d="M5 14l.8 2.2L8 17l-2.2.8L5 20l-.8-2.2L2 17l2.2-.8L5 14z"></path>`,
    tag: `<path d="M20.6 13.1 13 20.7a2 2 0 0 1-2.8 0L3.3 13.8a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h7.4a2 2 0 0 1 1.4.6l7.1 7.1a1.9 1.9 0 0 1 0 2.4Z"></path><circle cx="7.5" cy="7.5" r=".5"></circle>`,
    refresh: `<path d="M21 12a9 9 0 0 1-9 9 9.8 9.8 0 0 1-6.7-2.7L3 16"></path><path d="M3 21v-5h5"></path><path d="M3 12a9 9 0 0 1 9-9 9.8 9.8 0 0 1 6.7 2.7L21 8"></path><path d="M21 3v5h-5"></path>`,
  };

  return icons[name] ?? "";
}

function primaryDate(post: PostItem) {
  return showUpdatedDateOnly && hasUpdatedDate(post)
    ? post.data.modDatetime
    : post.data.pubDatetime ?? post.data.date;
}

function primaryDateIsUpdate(post: PostItem) {
  return showUpdatedDateOnly && hasUpdatedDate(post);
}

function primaryDateIcon(post: PostItem) {
  return primaryDateIsUpdate(post) ? "refresh" : "calendar";
}
---

<ul class:list={["paper-post-list", `paper-post-list-${view}`]}>
  {
    posts.map(post => (
      <li class:list={[post.data.pinned && "paper-post-list-pinned"]}>
        <a href={postHref(post, basePath)}>
          {post.data.cover && <img class="paper-post-cover" src={getAssetPath(post.data.cover)} alt="" loading="lazy" />}
          <span class="paper-post-title" transition:name={toTransitionName(post.data.title)}>{post.data.title}</span>
          {post.data.description && <span class="paper-post-description">{post.data.description}</span>}
          <span class="paper-post-meta">
            <span class:list={["paper-meta-item", showFreshIndicators && primaryDateIsUpdate(post) && hasFreshUpdate(post) && "paper-post-recently-updated"]}>
              <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon(primaryDateIcon(post))} />
              {formatPostDate(primaryDate(post))}
            </span>
            {!showUpdatedDateOnly && post.data.modDatetime && formatPostDate(post.data.modDatetime) !== formatPostDate(post.data.pubDatetime ?? post.data.date) ? (
              <span class:list={["paper-meta-item", showFreshIndicators && hasFreshUpdate(post) && "paper-post-recently-updated"]}>
                <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("refresh")} />
                {formatPostDate(post.data.modDatetime)}
              </span>
            ) : ""}
            {showReadTime ? (
              <span class="paper-meta-item">
                <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("clock")} />
                {readingTime(post.body)}
              </span>
            ) : ""}
            {!showTags && showFirstTagWhenTagsHidden && postTags(post)[0] ? (
              <span class="paper-meta-item paper-post-inline-tag">
                <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("tag")} />
                #{postTags(post)[0]}
              </span>
            ) : ""}
            {post.data.pinned ? (
              <span class="paper-meta-item">
                <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("pin")} />
                {showPinnedText && "pinned"}
              </span>
            ) : ""}
            {showFreshIndicators && isNewPost(post) ? (
              <span class="paper-meta-item paper-post-fresh">
                <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("sparkles")} />
                {showFreshIndicatorText && "new"}
              </span>
            ) : ""}
          </span>
        </a>
        {
          showTags && postTags(post).length > 0 && (
            <p class="paper-tags paper-post-list-tags">
              <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("tag")} />
              {postTags(post).map(tag => <a href={tagHref(tag)}>#{tag}</a>)}
            </p>
          )
        }
      </li>
    ))
  }
</ul>
