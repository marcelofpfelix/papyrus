---
import { stripBase } from "../utils/withBase";

export interface NavItem {
  href: string;
  label: string;
}

interface Props {
  title?: string;
  brandTitle?: string;
  brandMark?: "twinkle" | "terminal";
  brandAriaLabel?: string;
  showBrandTitle?: boolean;
  homeHref?: string;
  nav?: NavItem[];
  searchHref?: string;
}

const {
  title,
  brandTitle = title ?? "papyrus",
  brandMark = "twinkle",
  brandAriaLabel,
  showBrandTitle = brandMark === "twinkle",
  homeHref = "/",
  nav = [],
  searchHref,
} = Astro.props;
const resolvedBrandAriaLabel = brandAriaLabel ?? "Home";
const currentPath = stripBase(Astro.url.pathname);
---

<header class="papyrus-header" data-papyrus-header>
  <a class="papyrus-brand papyrus-logo-link" href={homeHref} aria-label={resolvedBrandAriaLabel}>
    <slot name="logo">
      {brandMark === "twinkle" ? (
        <>
          <svg class="papyrus-brand-mark" aria-hidden="true" viewBox="-5 -10 110 110">
            <path d="m61.383 45.285 10.68-14.574c0.36719-0.50391-0.19531-1.1562-0.74609-0.86328l-16.598 8.7695-4.1328-31.031c-0.089844-0.67969-1.0703-0.67969-1.1641 0l-4.1328 31.031-14.621-8.7578c-0.52344-0.3125-1.1172 0.28125-0.80469 0.80469l8.7578 14.621-31.031 4.1328c-0.67969 0.089843-0.67969 1.0703 0 1.1641l31.031 4.1328-8.7578 14.621c-0.3125 0.52344 0.28125 1.1172 0.80469 0.80469l14.621-8.7578 4.1328 31.031c0.089844 0.67969 1.0703 0.67969 1.1641 0l4.1328-31.031 14.621 8.7578c0.52344 0.3125 1.1172-0.28125 0.80469-0.80469l-8.7578-14.621 31.031-4.1328c0.67969-0.089843 0.67969-1.0703 0-1.1641l-31.031-4.1328z"></path>
          </svg>
          {showBrandTitle && <span class="papyrus-brand-title">{brandTitle}</span>}
        </>
      ) : (
        <>
          <span>{title ?? brandTitle}</span>
          <span class="papyrus-cursor" aria-hidden="true"></span>
        </>
      )}
    </slot>
  </a>
  <div class="papyrus-header-actions">
    <nav class="papyrus-nav" aria-label="Main navigation">
      {
        nav.map(item => (
          <a href={item.href} class:list={{ "is-active": currentPath === stripBase(item.href) }}>
            {item.label}
          </a>
        ))
      }
    </nav>
    {
      searchHref && (
        <a class="papyrus-icon-button" href={searchHref} aria-label="Search" title="Search">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m16 16 4.5 4.5"></path>
          </svg>
        </a>
      )
    }
    <details class="papyrus-mobile-nav">
      <summary class="papyrus-icon-button" aria-label="Open menu" title="Menu">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>
      </summary>
      <nav aria-label="Mobile navigation">
        {nav.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
