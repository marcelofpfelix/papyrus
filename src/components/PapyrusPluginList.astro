---
import type { PapyrusPluginDefinition } from "../utils/plugins";

const { plugins } = Astro.props as {
  plugins: PapyrusPluginDefinition[];
};
---

<div class="papyrus-plugin-list">
  {plugins.map((plugin) => (
    <article class="papyrus-plugin-card">
      <h3>
        {plugin.docsUrl ? <a href={plugin.docsUrl}>{plugin.name}</a> : plugin.name}
      </h3>
      <p>{plugin.description}</p>
      {plugin.packageName && <p class="papyrus-plugin-package"><code>{plugin.packageName}</code></p>}
      {plugin.capabilities?.length ? (
        <ul>
          {plugin.capabilities.map((capability) => (
            <li><strong>{capability.kind}</strong> {capability.name}{capability.description ? ` - ${capability.description}` : ""}</li>
          ))}
        </ul>
      ) : null}
    </article>
  ))}
</div>
