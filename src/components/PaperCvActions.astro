---
import { cvIconSvg } from "../utils/cv-icons";

type ActionLink = {
  label: string;
  href: string;
};

const {
  markdownHref,
  shareText,
  sourceLinks = [],
  versionLinks = [],
  backHref,
  profile = false,
  print = false,
  printLabel = "Print / save PDF",
  versionLabel = "Version",
  sourceLabel = "Source",
} = Astro.props as {
  markdownHref: string;
  shareText?: string;
  sourceLinks?: ActionLink[];
  versionLinks?: ActionLink[];
  backHref?: string;
  profile?: boolean;
  print?: boolean;
  printLabel?: string;
  versionLabel?: string;
  sourceLabel?: string;
};

const rootClass = profile ? "cv-actions" : "no-print cv-download";
const actionClass = profile ? "cv-action" : undefined;
const printMenuLabel = profile ? "PDF / Print" : versionLabel;
---

<div class={rootClass} data-cv-actions data-cv-markdown-url={markdownHref} data-cv-share-text={shareText}>
  {backHref && (
    <a class={actionClass} href={backHref}>
      <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIconSvg("back")} />
      <span>Back</span>
    </a>
  )}
  {print && (
    <button class={actionClass} type="button" onclick="window.print()">
      <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIconSvg("document")} />
      <span>{printLabel}</span>
    </button>
  )}
  {versionLinks.length > 0 && (
    <details class:list={["cv-source-menu", profile && "cv-print-menu"]}>
      <summary class={actionClass}>
        <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIconSvg(profile ? "document" : "version")} />
        <span>{printMenuLabel}</span>
      </summary>
      <span class="cv-source-links">
        {versionLinks.map(link => <a href={link.href}>{link.label}</a>)}
      </span>
    </details>
  )}
  <button class={actionClass} type="button" data-cv-share>
    <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIconSvg("share")} />
    <span>Share</span>
  </button>
  <button class={actionClass} type="button" data-cv-copy-markdown>
    <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIconSvg("copy")} />
    <span>Copy</span>
  </button>
  {sourceLinks.length > 0 && (
    <details class="cv-source-menu">
      <summary class={actionClass}>
        <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIconSvg("source")} />
        <span>{sourceLabel}</span>
      </summary>
      <span class="cv-source-links">
        {sourceLinks.map(link => <a href={link.href}>{link.label}</a>)}
      </span>
    </details>
  )}
  <span class="cv-action-status" aria-live="polite" data-cv-action-status></span>
</div>

<style>
  .cv-actions,
  .cv-download {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .cv-action,
  .cv-download button,
  .cv-download > a,
  .cv-source-menu summary {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: 6px;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    gap: 6px;
    line-height: 1.2;
    min-height: 36px;
    padding: 7px 4px;
    text-decoration: none;
  }

  .cv-action:hover,
  .cv-action:focus-visible,
  .cv-download button:hover,
  .cv-download button:focus-visible,
  .cv-download > a:hover,
  .cv-download > a:focus-visible,
  .cv-source-menu summary:hover,
  .cv-source-menu summary:focus-visible {
    color: var(--paper-accent, currentColor);
    outline: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cv-action svg,
  .cv-download button svg,
  .cv-download > a svg,
  .cv-source-menu summary svg {
    flex: 0 0 auto;
    height: 18px;
    width: 18px;
  }

  .cv-source-menu {
    display: inline-flex;
    position: relative;
  }

  .cv-source-menu summary {
    list-style: none;
  }

  .cv-source-menu summary::-webkit-details-marker {
    display: none;
  }

  .cv-source-links {
    background: var(--paper-panel, canvas);
    border: 1px solid var(--paper-border, currentColor);
    border-radius: 6px;
    box-shadow: 0 10px 30px color-mix(in srgb, currentColor 14%, transparent);
    display: grid;
    gap: 4px;
    left: 50%;
    min-width: 120px;
    padding: 8px;
    position: absolute;
    top: calc(100% + 6px);
    transform: translateX(-50%);
    z-index: 5;
  }

  .cv-source-menu:not([open]) .cv-source-links {
    display: none;
  }

  .cv-source-links a {
    border-radius: 4px;
    color: inherit;
    padding: 5px 7px;
    text-decoration: none;
  }

  .cv-source-links a:hover,
  .cv-source-links a:focus-visible {
    background: color-mix(in srgb, var(--paper-accent, currentColor) 12%, transparent);
    color: var(--paper-accent, currentColor);
    outline: none;
  }

  .cv-action-status {
    color: var(--paper-muted, currentColor);
    min-width: 1px;
  }
</style>

<script>
  function initPaperCvActions() {
    const actions = document.querySelector<HTMLElement>("[data-cv-actions]");
    if (!actions || actions.dataset.cvActionsBound) return;
    actions.dataset.cvActionsBound = "true";
    const status = actions.querySelector<HTMLElement>("[data-cv-action-status]");

    function setStatus(message: string) {
      if (!status) return;
      status.textContent = message;
      window.setTimeout(() => {
        status.textContent = "";
      }, 2200);
    }

    async function copyText(text: string) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
      window.prompt("Copy CV markdown", text);
      return false;
    }

    actions.querySelector("[data-cv-copy-markdown]")?.addEventListener("click", async () => {
      const url = actions.dataset.cvMarkdownUrl;
      if (!url) return;
      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error("CV Markdown is not available.");
        await copyText(await response.text());
        setStatus("Markdown copied");
      } catch {
        setStatus("Copy failed");
      }
    });

    actions.querySelector("[data-cv-share]")?.addEventListener("click", async () => {
      try {
        if (navigator.share) {
          await navigator.share({
            title: document.title,
            text: actions.dataset.cvShareText || document.title,
            url: window.location.href,
          });
          return;
        }
        await copyText(window.location.href);
        setStatus("Link copied");
      } catch {
        setStatus("Share failed");
      }
    });
  }

  initPaperCvActions();
  document.addEventListener("astro:page-load", initPaperCvActions);
</script>
