---
const {
  json,
  markdown,
} = Astro.props as {
  json?: string;
  markdown?: string;
};

const jsonHref = json ? `data:application/json;charset=utf-8,${encodeURIComponent(json)}` : "";
const markdownHref = markdown ? `data:text/markdown;charset=utf-8,${encodeURIComponent(markdown)}` : "";
---

{(json || markdown) && (
  <div class="paper-cv-export-actions">
    {json && (
      <details class="paper-cv-export-card">
        <summary>JSON export</summary>
        <div class="paper-cv-export-toolbar">
          <button type="button" data-paper-cv-copy="json" data-paper-cv-payload={json}>
            <span class="paper-button-label">Copy JSON</span>
          </button>
          <a href={jsonHref} download="cv.json" data-paper-cv-download="json">Download JSON</a>
        </div>
        <pre><code>{json}</code></pre>
      </details>
    )}
    {markdown && (
      <details class="paper-cv-export-card">
        <summary>Markdown export</summary>
        <div class="paper-cv-export-toolbar">
          <button type="button" data-paper-cv-copy="markdown" data-paper-cv-payload={markdown}>
            <span class="paper-button-label">Copy Markdown</span>
          </button>
          <a href={markdownHref} download="cv.md" data-paper-cv-download="markdown">Download Markdown</a>
        </div>
        <pre><code>{markdown}</code></pre>
      </details>
    )}
  </div>
)}

<script>
  async function writeCvClipboard(text: string) {
    if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
    await navigator.clipboard.writeText(text);
    return "copied";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-paper-cv-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const label = button.querySelector<HTMLElement>(".paper-button-label");
      const original = label?.textContent ?? "Copy";

      try {
        await writeCvClipboard(button.dataset.paperCvPayload ?? "");
        button.dataset.state = "copied";
        if (label) label.textContent = button.dataset.paperCvCopy === "json" ? "JSON copied" : "Markdown copied";
      } catch {
        button.dataset.state = "failed";
        if (label) label.textContent = "Copy failed";
      }

      window.setTimeout(() => {
        button.dataset.state = "";
        if (label) label.textContent = original;
      }, 1800);
    });
  });
</script>
