---
interface SectionLink {
  href: string;
  title: string;
}

interface Props {
  sections: SectionLink[];
  label?: string;
}

const { sections = [], label = "Sections" } = Astro.props;

function icon() {
  return `<path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h12"></path>`;
}
---

{
  sections.length > 0 && (
    <details class="papyrus-section-menu" data-papyrus-section-menu>
      <summary aria-label={label} title={label}>
        <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon()} />
      </summary>
      <nav aria-label={label}>
        {sections.map(section => <a href={section.href}>{section.title}</a>)}
      </nav>
    </details>
  )
}
