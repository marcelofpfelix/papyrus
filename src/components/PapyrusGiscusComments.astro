---
import { papyrusThemeProfiles } from "../utils/theme-profiles";
import { withBase } from "../utils/withBase";

interface Props {
  enabled?: boolean;
  repo?: string;
  repoId?: string;
  category?: string;
  categoryId?: string;
  mapping?: "pathname" | "url" | "title" | "og:title" | "specific" | "number";
  term?: string;
  number?: number;
  description?: string;
  backLink?: string;
  strict?: boolean;
  reactionsEnabled?: boolean;
  emitMetadata?: boolean;
  inputPosition?: "top" | "bottom";
  lang?: string;
  theme?: string;
  lightTheme?: string;
  darkTheme?: string;
  loading?: "lazy" | "eager";
  fallbackText?: string;
}

const {
  enabled = true,
  repo,
  repoId,
  category,
  categoryId,
  mapping = "pathname",
  term,
  number,
  description,
  backLink,
  strict = false,
  reactionsEnabled = true,
  emitMetadata = false,
  inputPosition = "bottom",
  lang = "en",
  theme = "preferred_color_scheme",
  lightTheme = "papyrus",
  darkTheme = "papyrus",
  loading = "lazy",
  fallbackText = "Comments are disabled until the site configures its Giscus repository and category IDs.",
} = Astro.props;

const isConfigured = enabled && repo && repoId && category && categoryId;
const themeBasePath = withBase("/giscus/");
const themeProfiles = Array.from(papyrusThemeProfiles);
---

<section
  id="comments"
  class="papyrus-comments"
  aria-label="Comments"
  data-papyrus-giscus
  data-light-theme={lightTheme}
  data-dark-theme={darkTheme}
  data-theme-base-path={themeBasePath}
>
  {
    isConfigured ? (
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping={mapping}
        data-term={term}
        data-number={number}
        data-description={description}
        data-back-link={backLink}
        data-strict={strict ? "1" : "0"}
        data-reactions-enabled={reactionsEnabled ? "1" : "0"}
        data-emit-metadata={emitMetadata ? "1" : "0"}
        data-input-position={inputPosition}
        data-theme={theme}
        data-lang={lang}
        data-loading={loading}
        crossorigin="anonymous"
        async
      />
    ) : (
      <p class="papyrus-comments-placeholder">{fallbackText}</p>
    )
  }
</section>

{
  isConfigured && (
    <script is:inline define:vars={{ themeProfiles }}>
      const PAPYRUS_GISCUS_THEME_PROFILES = new Set(themeProfiles);

      function papyrusGiscusThemeProfile(profile) {
        return profile && PAPYRUS_GISCUS_THEME_PROFILES.has(profile) ? profile : "gruvbox";
      }

      function papyrusGiscusThemeValue(root, theme, mode, profile) {
        if (!theme || theme !== "papyrus") return theme;

        const basePath = root.dataset.themeBasePath || "/giscus/";
        const normalizedBase = basePath.endsWith("/") ? basePath : `${basePath}/`;
        return new URL(`${normalizedBase}${papyrusGiscusThemeProfile(profile)}/${mode}.css`, window.location.href).href;
      }

      function syncPapyrusGiscusTheme(event) {
        const detail = event instanceof CustomEvent ? event.detail : {};
        const mode = detail.mode ?? (document.documentElement.classList.contains("dark") ? "dark" : "light");
        const profile = detail.profile ?? document.documentElement.dataset.papyrusTheme;

        document.querySelectorAll("[data-papyrus-giscus]").forEach(root => {
          const theme = papyrusGiscusThemeValue(root, mode === "dark" ? root.dataset.darkTheme : root.dataset.lightTheme, mode, profile);
          const frame = root.querySelector("iframe.giscus-frame");
          if (!theme || !frame?.contentWindow) return;
          frame.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, "https://giscus.app");
        });
      }

      document.addEventListener("papyrus:theme-change", syncPapyrusGiscusTheme);
      window.addEventListener("message", event => {
        if (event.origin === "https://giscus.app") syncPapyrusGiscusTheme();
      });
      document.addEventListener("astro:page-load", () => syncPapyrusGiscusTheme());
    </script>
  )
}
