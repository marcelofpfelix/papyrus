---
import PapyrusTocHeading, { type TocItem } from "./PapyrusTocHeading.astro";
import { TOC as PureToc } from "astro-pure/components/pages";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface TocLink {
  href: string;
  title: string;
  depth?: number;
}

interface Props {
  headings?: Heading[];
  links?: TocLink[];
  title?: string;
  panelTitle?: string;
  linksTitle?: string;
  collapsed?: boolean;
}

const {
  headings = [],
  links = [],
  title = "On this page",
  panelTitle = "Table of contents",
  linksTitle = "Sections",
  collapsed = true,
} = Astro.props;
const visibleHeadings = headings.filter(heading => heading.depth > 1 && heading.depth <= 3);
const headingItems = visibleHeadings.map(heading => ({
  href: `#${heading.slug}`,
  title: heading.text,
  depth: heading.depth,
}));
const sectionItems = links.map(link => ({
  href: link.href,
  title: link.title,
  depth: link.depth ?? 2,
}));

function generateToc(items: Array<{ href: string; title: string; depth: number }>): TocItem[] {
  const root: TocItem = { depth: 0, href: "#", title: "Root", subheadings: [] };
  const stack: TocItem[] = [root];

  items.forEach(item => {
    const heading: TocItem = { ...item, subheadings: [] };

    while ((stack.at(-1)?.depth ?? 0) >= heading.depth) {
      stack.pop();
    }

    stack.at(-1)?.subheadings.push(heading);
    stack.push(heading);
  });

  return root.subheadings;
}

const sectionTocItems = generateToc(sectionItems);
const hasHeadings = headingItems.length > 0;
const hasSections = sectionItems.length > 0;
---

{
  (hasHeadings || hasSections) && (
    <papyrus-toc-runtime class="papyrus-toc" data-open={collapsed ? "false" : "true"}>
      <button class="papyrus-toc-toggle" type="button" aria-label={title} aria-expanded={collapsed ? "false" : "true"} title={title} data-papyrus-toc-toggle>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M8 6h13"></path>
          <path d="M8 12h13"></path>
          <path d="M8 18h13"></path>
          <path d="M3 6h.01"></path>
          <path d="M3 12h.01"></path>
          <path d="M3 18h.01"></path>
        </svg>
        <span class="papyrus-toc-label">{title}</span>
      </button>
      <button class="papyrus-toc-shade" type="button" aria-label="Close table of contents" data-papyrus-toc-close></button>
      <aside class="papyrus-toc-panel" aria-label={title} data-papyrus-toc-panel>
        {hasHeadings && (
          <>
            <p class="papyrus-toc-title">{panelTitle}</p>
            <div class="papyrus-pure-toc">
              <PureToc headings={visibleHeadings} />
            </div>
          </>
        )}
        {hasSections && (
          <>
            <p class:list={["papyrus-toc-title", hasHeadings && "papyrus-toc-title--spaced"]}>{linksTitle}</p>
            <ol>
              {sectionTocItems.map(item => <PapyrusTocHeading heading={item} />)}
            </ol>
          </>
        )}
      </aside>
    </papyrus-toc-runtime>
  )
}

<script>
  class PapyrusTocRuntime extends HTMLElement {
    headings: HTMLElement[] = [];
    tocLinks: Array<{ element: HTMLAnchorElement; progressBar: HTMLElement; slug: string }> = [];
    headingProgress: Record<string, { inView: boolean; progress: number }> = {};

    connectedCallback() {
      const toggle = this.querySelector("[data-papyrus-toc-toggle]");
      const close = this.querySelector("[data-papyrus-toc-close]");
      const setOpen = (open: boolean) => {
        this.dataset.open = open ? "true" : "false";
        toggle?.setAttribute("aria-expanded", open ? "true" : "false");
      };

      toggle?.addEventListener("click", () => setOpen(this.dataset.open !== "true"));
      close?.addEventListener("click", () => setOpen(false));

      this.headings = Array.from(document.querySelectorAll("article h1, article h2, article h3, article h4, article h5, article h6, main section[id] > h2, main .papyrus-content-index li[id]"))
        .filter((heading): heading is HTMLElement => heading instanceof HTMLElement && Boolean(heading.id || heading.parentElement?.id));
      this.tocLinks = Array.from(this.querySelectorAll("a[href^='#']")).flatMap(link => {
        if (!(link instanceof HTMLAnchorElement)) return [];
        const progressBar = link.previousElementSibling;
        if (!(progressBar instanceof HTMLElement)) return [];

        return [{
          element: link,
          progressBar,
          slug: (link.getAttribute("href") ?? "").slice(1),
        }];
      });

      this.tocLinks.forEach(link => {
        link.element.addEventListener("click", event => {
          const target = document.getElementById(link.slug);
          if (!target) return;

          event.preventDefault();
          history.pushState(null, target.textContent ?? "", link.element.getAttribute("href"));
          setOpen(false);
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      this.updatePositionAndStyle();
      window.addEventListener("scroll", this.updatePositionAndStyle, { passive: true });
    }

    disconnectedCallback() {
      window.removeEventListener("scroll", this.updatePositionAndStyle);
    }

    updatePositionAndStyle = () => {
      const windowHeight = window.innerHeight;

      this.headings.forEach((heading, index) => {
        const id = heading.id || heading.parentElement?.id;
        if (!id) return;

        const nextHeading = this.headings[index + 1];
        const top = heading.getBoundingClientRect().top;
        const nextTop = nextHeading?.getBoundingClientRect().top ?? document.body.getBoundingClientRect().bottom;
        const range = Math.max(nextTop - top, 1);
        const progress = (windowHeight - top) / range;

        this.headingProgress[id] = {
          inView: top < windowHeight * 0.4 && nextTop > 80,
          progress: Math.max(0, Math.min(1, progress)),
        };
      });

      this.tocLinks.forEach(({ element, progressBar, slug }) => {
        const heading = this.headingProgress[slug];
        if (!heading) return;

        element.classList.toggle("is-active", heading.inView);
        progressBar.classList.toggle("is-read", !heading.inView && heading.progress === 1);
        progressBar.classList.toggle("is-active", heading.inView);
        progressBar.style.setProperty("--papyrus-toc-progress", `${heading.progress * 90}%`);
      });
    };
  }

  if (!customElements.get("papyrus-toc-runtime")) {
    customElements.define("papyrus-toc-runtime", PapyrusTocRuntime);
  }
</script>

<style is:global>
  .papyrus-pure-toc toc-heading > h2 {
    display: none;
  }

  .papyrus-pure-toc ul {
    display: grid;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .papyrus-pure-toc li > div {
    display: grid;
    grid-template-columns: 2px minmax(0, 1fr);
    position: relative;
  }

  .papyrus-pure-toc li > div > span {
    align-self: stretch;
    background: transparent;
    border-radius: 999px;
    display: block;
    margin: 3px 0;
    min-height: 1.6em;
    position: static;
    transition: background-color 160ms ease, height 160ms ease;
    width: 2px;
  }

  .papyrus-pure-toc li > div > span.is-read {
    background: var(--papyrus-border);
  }

  .papyrus-pure-toc li > div > span.highlight-bg {
    background: var(--papyrus-accent);
  }

  .papyrus-pure-toc .toc-item {
    border-radius: 6px;
    color: var(--papyrus-muted);
    display: -webkit-box;
    line-height: 1.35;
    margin-inline-start: 0;
    overflow: hidden;
    padding: 4px 8px;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .papyrus-pure-toc ul ul .toc-item {
    padding-inline-start: 26px;
  }

  .papyrus-pure-toc .toc-item:hover,
  .papyrus-pure-toc .toc-item:focus-visible,
  .papyrus-pure-toc .toc-item.highlight {
    color: var(--papyrus-accent);
    outline: none;
  }

  .papyrus-pure-toc .toc-item.highlight-bg-translucent {
    background: color-mix(in srgb, var(--papyrus-accent) 10%, transparent);
  }
</style>
