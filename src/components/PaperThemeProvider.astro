---
interface Props {
  defaultThemeProfile?: string;
  defaultFontProfile?: string;
}

const {
  defaultThemeProfile = "gruvbox",
  defaultFontProfile = "readable",
} = Astro.props;
---

<script
  is:inline
  data-default-theme-profile={defaultThemeProfile}
  data-default-font-profile={defaultFontProfile}
>
  const PAPER_THEME_PROFILES = ["pure", "catppuccin", "tokyo-night", "kanagawa", "rose-pine", "everforest", "dracula", "gruvbox", "nord"];
  const PAPER_FONT_PROFILES = ["theme", "readable", "code"];
  const PAPER_INLINE_SCRIPT = document.currentScript;
  const PAPER_INLINE_DEFAULT_THEME_PROFILE = PAPER_INLINE_SCRIPT?.dataset.defaultThemeProfile ?? "gruvbox";
  const PAPER_INLINE_DEFAULT_FONT_PROFILE = PAPER_INLINE_SCRIPT?.dataset.defaultFontProfile ?? "readable";
  const PAPER_MODE_STORAGE_KEY = "paper-mode";
  const PAPER_PROFILE_STORAGE_KEY = "paper-theme";
  const PAPER_FONT_STORAGE_KEY = "paper-font";

  function paperPureStoredMode() {
    return localStorage.getItem(PAPER_MODE_STORAGE_KEY) ?? localStorage.getItem("theme");
  }

  function paperPureStoredProfile() {
    return localStorage.getItem(PAPER_PROFILE_STORAGE_KEY) ?? PAPER_INLINE_DEFAULT_THEME_PROFILE;
  }

  function paperPureStoredFont() {
    return localStorage.getItem(PAPER_FONT_STORAGE_KEY) ?? PAPER_INLINE_DEFAULT_FONT_PROFILE;
  }

  function paperPureResolvedMode(mode) {
    if (!mode || mode === "system") {
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    return mode;
  }

  function paperPureApplyTheme(mode, profile) {
    const targetMode = paperPureResolvedMode(mode);
    const targetProfile = PAPER_THEME_PROFILES.includes(profile) ? profile : "pure";
    const targetFont = PAPER_FONT_PROFILES.includes(paperPureStoredFont()) ? paperPureStoredFont() : "theme";

    document.documentElement.classList.toggle("dark", targetMode === "dark");
    document.documentElement.dataset.paperTheme = targetProfile;
    document.documentElement.dataset.paperFont = targetFont;

    requestAnimationFrame(() => {
      const themeColor = getComputedStyle(document.documentElement).getPropertyValue("--paper-theme-color").trim();
      document.querySelector('meta[name="theme-color"]')?.setAttribute("content", themeColor || (targetMode === "dark" ? "#0B0B10" : "#FCFCFD"));
      document.dispatchEvent(new CustomEvent("paper:theme-change", {
        detail: { mode: targetMode, profile: targetProfile },
      }));
    });
  }

  function paperPureSetInitialTheme() {
    paperPureApplyTheme(paperPureStoredMode() ?? "system", paperPureStoredProfile());
  }

  paperPureSetInitialTheme();
  document.addEventListener("astro:page-load", () => paperPureSetInitialTheme());
</script>

<script
  is:inline
  data-default-theme-profile={defaultThemeProfile}
  data-default-font-profile={defaultFontProfile}
>
  const PAPER_RUNTIME_SCRIPT = document.currentScript;
  const PAPER_RUNTIME_DEFAULT_THEME_PROFILE = PAPER_RUNTIME_SCRIPT?.dataset.defaultThemeProfile ?? "gruvbox";
  const PAPER_RUNTIME_DEFAULT_FONT_PROFILE = PAPER_RUNTIME_SCRIPT?.dataset.defaultFontProfile ?? "readable";

  function getTheme() {
    return localStorage.getItem("paper-mode") ?? localStorage.getItem("theme");
  }

  function getThemeProfile() {
    return localStorage.getItem("paper-theme") ?? PAPER_RUNTIME_DEFAULT_THEME_PROFILE;
  }

  function getFontProfile() {
    return localStorage.getItem("paper-font") ?? PAPER_RUNTIME_DEFAULT_FONT_PROFILE;
  }

  function setTheme(theme, save = false) {
    const themes = ["system", "dark", "light"];
    if (theme) {
      if (!themes.includes(theme)) return theme;
      if (save) localStorage.setItem("paper-mode", theme);
    } else {
      theme = getTheme() ?? "system";
      if (save) {
        theme = themes[(themes.indexOf(theme) + 1) % themes.length];
        localStorage.setItem("paper-mode", theme);
      }
    }

    applyTheme(theme, getThemeProfile());

    return theme;
  }

  function applyTheme(mode, profile) {
    const targetMode = mode === "system" || !mode
      ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
      : mode;
    const targetProfile = profile && ["pure", "catppuccin", "tokyo-night", "kanagawa", "rose-pine", "everforest", "dracula", "gruvbox", "nord"].includes(profile) ? profile : "pure";

    document.documentElement.classList.toggle("dark", targetMode === "dark");
    document.documentElement.dataset.paperTheme = targetProfile;

    requestAnimationFrame(() => {
      const themeColor = getComputedStyle(document.documentElement).getPropertyValue("--paper-theme-color").trim();
      document.querySelector('meta[name="theme-color"]')?.setAttribute("content", themeColor || (targetMode === "dark" ? "#0B0B10" : "#FCFCFD"));
      document.dispatchEvent(new CustomEvent("paper:theme-change", {
        detail: { mode: targetMode, profile: targetProfile },
      }));
    });
  }

  function applyFontProfile(profile) {
    const profiles = ["theme", "readable", "code"];
    const targetProfile = profile && profiles.includes(profile) ? profile : "theme";
    document.documentElement.dataset.paperFont = targetProfile;
    return targetProfile;
  }

  function setThemeProfile(profile, save = false) {
    const profiles = ["pure", "catppuccin", "tokyo-night", "kanagawa", "rose-pine", "everforest", "dracula", "gruvbox", "nord"];
    const requestedProfile = profile;
    profile = profile && profiles.includes(profile) ? profile : getThemeProfile();

    if (save && !requestedProfile) {
      profile = profiles[(profiles.indexOf(profile) + 1) % profiles.length];
    }

    if (save) localStorage.setItem("paper-theme", profile);
    applyTheme(getTheme() ?? "system", profile);

    return profile;
  }

  function setFontProfile(profile, save = false) {
    const profiles = ["theme", "readable", "code"];
    const toggleProfiles = ["readable", "code"];
    const requestedProfile = profile;
    profile = profile && profiles.includes(profile) ? profile : getFontProfile();

    if (save && !requestedProfile) {
      const currentIndex = toggleProfiles.indexOf(profile);
      profile = toggleProfiles[(currentIndex + 1) % toggleProfiles.length];
    }

    if (save) localStorage.setItem("paper-font", profile);
    applyFontProfile(profile);

    return profile;
  }

  function syncThemeControls() {
    const mode = getTheme() ?? "system";
    const profile = getThemeProfile();
    const font = getFontProfile();

    document.querySelectorAll("[data-paper-theme-set]").forEach(button => {
      button.dataset.active = button.dataset.paperThemeSet === mode ? "true" : "false";
    });
    document.querySelectorAll("[data-paper-theme-toggle]").forEach(button => {
      button.dataset.theme = mode;
      button.setAttribute("aria-label", `Color mode: ${mode}`);
    });
    document.querySelectorAll("[data-paper-theme-profile-select]").forEach(select => {
      select.value = profile;
    });
    document.querySelectorAll("[data-paper-font-profile-select]").forEach(select => {
      select.value = font;
    });
    document.querySelectorAll("[data-paper-font-profile-toggle]").forEach(button => {
      button.dataset.font = font;
      button.setAttribute("aria-label", `Font profile: ${font}`);
    });
    document.querySelectorAll("[data-paper-theme-profile-value]").forEach(button => {
      button.dataset.active = button.dataset.paperThemeProfileValue === profile ? "true" : "false";
    });
    document.querySelectorAll("[data-paper-font-profile-value]").forEach(button => {
      button.dataset.active = button.dataset.paperFontProfileValue === font ? "true" : "false";
    });
  }

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", event => {
    const theme = getTheme();
    if (!theme || theme === "system") setTheme(event.matches ? "dark" : "light");
  });

  function bindThemeControls() {
    syncThemeControls();

    document.querySelectorAll("[data-paper-theme-toggle]").forEach(button => {
      if (button instanceof HTMLElement && button.dataset.paperBound) return;
      if (button instanceof HTMLElement) button.dataset.paperBound = "true";
      button.addEventListener("click", () => {
        setTheme(undefined, true);
        syncThemeControls();
      });
    });
    document.querySelectorAll("[data-paper-theme-set]").forEach(button => {
      if (button.dataset.paperBound) return;
      button.dataset.paperBound = "true";
      button.addEventListener("click", () => {
        setTheme(button.dataset.paperThemeSet, true);
        syncThemeControls();
      });
    });
    document.querySelectorAll("[data-paper-theme-profile]").forEach(button => {
      if (button instanceof HTMLElement && button.dataset.paperBound) return;
      if (button instanceof HTMLElement) button.dataset.paperBound = "true";
      button.addEventListener("click", () => {
        setThemeProfile(undefined, true);
        syncThemeControls();
      });
    });
    document.querySelectorAll("[data-paper-theme-profile-select]").forEach(select => {
      if (select.dataset.paperBound) return;
      select.dataset.paperBound = "true";
      select.addEventListener("change", () => {
        setThemeProfile(select.value, true);
        syncThemeControls();
      });
    });
    document.querySelectorAll("[data-paper-theme-profile-value]").forEach(button => {
      if (button.dataset.paperBound) return;
      button.dataset.paperBound = "true";
      button.addEventListener("click", () => {
        setThemeProfile(button.dataset.paperThemeProfileValue, true);
        button.closest("details")?.removeAttribute("open");
        syncThemeControls();
      });
    });
    document.querySelectorAll("[data-paper-font-profile-select]").forEach(select => {
      if (select.dataset.paperBound) return;
      select.dataset.paperBound = "true";
      select.addEventListener("change", () => {
        setFontProfile(select.value, true);
        syncThemeControls();
      });
    });
    document.querySelectorAll("[data-paper-font-profile-toggle]").forEach(button => {
      if (button instanceof HTMLElement && button.dataset.paperBound) return;
      if (button instanceof HTMLElement) button.dataset.paperBound = "true";
      button.addEventListener("click", () => {
        setFontProfile(undefined, true);
        syncThemeControls();
      });
    });
    document.querySelectorAll("[data-paper-font-profile-value]").forEach(button => {
      if (button.dataset.paperBound) return;
      button.dataset.paperBound = "true";
      button.addEventListener("click", () => {
        setFontProfile(button.dataset.paperFontProfileValue, true);
        button.closest("details")?.removeAttribute("open");
        syncThemeControls();
      });
    });
  }

  function setupThemeControls() {
    setFontProfile(getFontProfile());
    bindThemeControls();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupThemeControls, { once: true });
  } else {
    setupThemeControls();
  }

  document.addEventListener("astro:page-load", setupThemeControls);
</script>
