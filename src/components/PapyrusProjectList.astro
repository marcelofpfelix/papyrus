---
import { getAssetPath, withBase } from "../utils/withBase";

interface ProjectItem {
  title: string;
  description: string;
  href?: string;
  image?: string;
  links?: ProjectLink[];
  status?: string;
  repo?: string;
  language?: string;
  stars?: number;
  pinned?: boolean | number;
}

interface ProjectLink {
  href: string;
  label: string;
  text?: string;
}

interface Props {
  projects: ProjectItem[];
  headingLevel?: 2 | 3;
}

const { projects, headingLevel = 3 } = Astro.props;
const ProjectHeading = headingLevel === 2 ? "h2" : "h3";

function href(value?: string) {
  return value ? withBase(value) : undefined;
}

function projectLinks(project: ProjectItem) {
  const candidates = project.links?.length
    ? project.links
    : [
        project.href && project.href !== project.repo && { href: project.href, label: "website" },
        project.repo && { href: project.repo, label: "repo" },
      ].filter(Boolean) as ProjectLink[];

  return candidates.reduce<ProjectLink[]>((links, link) => {
    const existingIndex = links.findIndex((item) => item.href === link.href);
    if (existingIndex === -1) return [...links, link];

    const existing = links[existingIndex];
    const linkIsRepo = link.href === project.repo && /repo|github/i.test(link.label);
    const existingIsRepo = existing.href === project.repo && /repo|github/i.test(existing.label);
    if (linkIsRepo && !existingIsRepo) {
      return links.map((item, index) => index === existingIndex ? link : item);
    }

    return links;
  }, []);
}

function iconForLink(link: ProjectLink, project: ProjectItem) {
  const label = link.label.toLowerCase();
  if (link.href === project.repo || label.includes("repo") || label.includes("github")) return "github";
  if (label.includes("doc")) return "book";
  if (label.includes("package") || label.includes("npm")) return "package";
  if (label.includes("demo") || label.includes("website") || label.includes("site")) return "external";
  if (label.includes("data")) return "database";
  if (label.includes("graph")) return "graph";
  return "external";
}

function linkText(link: ProjectLink) {
  return link.text ?? link.label;
}

function icon(name: string) {
  const icons: Record<string, string> = {
    book: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>`,
    database: `<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"></path><path d="M3 12c0 1.7 4 3 9 3s9-1.3 9-3"></path>`,
    external: `<path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>`,
    github: `<path d="M15 21v-3.5a3.2 3.2 0 0 0-.9-2.5c3-.3 6.1-1.5 6.1-6.5a5 5 0 0 0-1.4-3.5 4.7 4.7 0 0 0-.1-3.4s-1.1-.4-3.6 1.3a12.2 12.2 0 0 0-6.2 0C6.4 1.7 5.3 2.1 5.3 2.1a4.7 4.7 0 0 0-.1 3.4 5 5 0 0 0-1.4 3.5c0 5 3.1 6.2 6.1 6.5a2.8 2.8 0 0 0-.8 1.7c-.7.3-2.5.8-3.6-1a2.6 2.6 0 0 0-1.9-1.3s-1.2 0-.1.7a3.3 3.3 0 0 1 1.4 1.8s.8 2.5 4.1 1.6V21"></path>`,
    graph: `<circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><circle cx="12" cy="18" r="3"></circle><path d="m8.6 7.5 6.8 0"></path><path d="m7.5 8.6 3 6.8"></path><path d="m16.5 8.6-3 6.8"></path>`,
    package: `<path d="m21 8-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path>`,
    pin: `<path d="m15 4 5 5-4 4v5l-2 2-5.5-5.5L4 19l-1-1 4.5-4.5L2 8l2-2h5z"></path>`,
    star: `<path d="m12 2 3 6.2 6.8 1-4.9 4.8 1.2 6.8-6.1-3.2-6.1 3.2 1.2-6.8-4.9-4.8 6.8-1z"></path>`,
  };

  return icons[name] ?? "";
}
---

<div class="papyrus-project-grid">
  {
    projects.map(project => {
      const links = projectLinks(project);

      return (
      <article class:list={["papyrus-project-card", project.repo && "papyrus-github-card"]}>
        {project.image && (
          project.href
            ? <a class="papyrus-project-image-link" href={href(project.href)} aria-label={`Open ${project.title}`}><img src={getAssetPath(project.image)} alt="" loading="lazy" /></a>
            : <img src={getAssetPath(project.image)} alt="" loading="lazy" />
        )}
        <header>
          <ProjectHeading>
            {project.repo && <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("book")} />}
            {project.href ? <a href={href(project.href)}>{project.title}</a> : project.title}
          </ProjectHeading>
        </header>
        <p>
          {project.href ? <a class="papyrus-project-description-link" href={href(project.href)}>{project.description}</a> : project.description}
        </p>
        {links.length > 0 && (
          <nav class="papyrus-project-links" aria-label={`${project.title} links`}>
            {links.map(link => (
              <a href={href(link.href)}>
                <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon(iconForLink(link, project))} />
                {linkText(link)}
              </a>
            ))}
          </nav>
        )}
      </article>
      );
    })
  }
</div>
