---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  title?: string;
  collapsed?: boolean;
}

const { headings = [], title = "On this page", collapsed = true } = Astro.props;
const visibleHeadings = headings.filter(heading => heading.depth > 1 && heading.depth <= 3);
---

{
  visibleHeadings.length > 0 && (
    <details class="paper-toc paper-floating-toc" open={!collapsed}>
      <summary aria-label={title} title={title}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M8 6h13"></path>
          <path d="M8 12h13"></path>
          <path d="M8 18h13"></path>
          <path d="M3 6h.01"></path>
          <path d="M3 12h.01"></path>
          <path d="M3 18h.01"></path>
        </svg>
        <span class="paper-toc-label">{title}</span>
      </summary>
      <div class="paper-toc-panel">
        <p class="paper-toc-title">Table of contents</p>
        <ol>
          {visibleHeadings.map(heading => (
            <li style={`--paper-toc-depth: ${heading.depth - 2}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </div>
    </details>
  )
}
