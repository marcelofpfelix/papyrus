---
import { postHref } from "../utils/posts";

interface PostLink {
  id: string;
  data: {
    title: string;
    slug?: string;
  };
}

interface Props {
  previous?: PostLink;
  next?: PostLink;
  basePath?: string;
}

const { previous, next, basePath = "/posts" } = Astro.props;

function href(post: PostLink) {
  return postHref(post, basePath);
}
---

{
  (previous || next) && (
    <nav class="paper-adjacent-posts" aria-label="Adjacent posts">
      <div>
        {previous && (
          <a href={href(previous)}>
            <span>Previous</span>
            <strong>{previous.data.title}</strong>
          </a>
        )}
      </div>
      <div>
        {next && (
          <a href={href(next)}>
            <span>Next</span>
            <strong>{next.data.title}</strong>
          </a>
        )}
      </div>
    </nav>
  )
}
