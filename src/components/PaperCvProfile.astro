---
import PaperCvHero from "./PaperCvHero.astro";
import PaperCvLinks from "./PaperCvLinks.astro";
import PaperCvSections from "./PaperCvSections.astro";
import type { PaperCvSectionOverrides, PaperCvUser } from "../utils/cv";

const {
  user,
  variant = "terminal",
  showSource = false,
  sourceHref = "/demo/users.toml",
  sectionOverrides = {},
} = Astro.props as {
  user: PaperCvUser;
  variant?: "terminal" | "timeline" | "a4" | "cards" | string;
  showSource?: boolean;
  sourceHref?: string;
  sectionOverrides?: PaperCvSectionOverrides;
};
---

<section class:list={["paper-cv", `paper-cv--${variant}`]}>
  <PaperCvHero user={user} />
  <PaperCvLinks links={user.links} />

  {showSource && (
    <p class="paper-cv-source">
      Profile data source: <a href={sourceHref}>normalized CV users.toml</a>
    </p>
  )}

  <PaperCvSections sections={user.sections} sectionOverrides={sectionOverrides} />
</section>
