---
interface Props {
  artifactLinks?: boolean;
  imageZoom?: boolean;
  mermaid?: boolean;
  videoDither?: boolean;
}

const {
  artifactLinks = true,
  imageZoom = true,
  mermaid = true,
  videoDither = true,
} = Astro.props as Props;

const runtimeConfig = JSON.stringify({ artifactLinks, imageZoom, mermaid, videoDither });
---

<script is:inline type="application/json" data-papyrus-media-runtime set:html={runtimeConfig} />

<script>
  const mediaConfigElement = document.querySelector<HTMLScriptElement>("[data-papyrus-media-runtime]");
  const mediaConfig = JSON.parse(mediaConfigElement?.textContent ?? "{}") as {
    artifactLinks?: boolean;
    imageZoom?: boolean;
    mermaid?: boolean;
    videoDither?: boolean;
  };
  const artifactLinksEnabled = mediaConfig.artifactLinks !== false;
  const imageZoomEnabled = mediaConfig.imageZoom !== false;
  const mermaidEnabled = mediaConfig.mermaid !== false;
  const videoDitherEnabled = mediaConfig.videoDither !== false;

  function bindImageZoom() {
    let overlay = document.querySelector<HTMLButtonElement>("[data-papyrus-image-zoom]");
    if (!overlay) {
      const createdOverlay = document.createElement("button");
      createdOverlay.type = "button";
      createdOverlay.className = "papyrus-image-zoom-overlay";
      createdOverlay.dataset.papyrusImageZoom = "";
      createdOverlay.setAttribute("aria-label", "Close image preview");
      document.body.append(createdOverlay);
      createdOverlay.addEventListener("click", () => {
        createdOverlay.dataset.open = "false";
        createdOverlay.replaceChildren();
      });
      overlay = createdOverlay;
    }
    const zoomOverlay = overlay;

    if (!imageZoomEnabled) return;

    document.querySelectorAll<HTMLElement>(".papyrus-prose img, .papyrus-mermaid svg").forEach(element => {
      if (element.dataset.papyrusZoomBound) return;
      element.dataset.papyrusZoomBound = "true";
      element.style.cursor = "zoom-in";
      element.addEventListener("click", () => {
        const clone = element.cloneNode(true) as HTMLElement;
        clone.removeAttribute("style");
        zoomOverlay.replaceChildren(clone);
        zoomOverlay.dataset.open = "true";
      });
    });
  }

  async function hydrateArtifactLinks() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".papyrus-artifact-link[data-artifact-type]"));

    await Promise.all(
      links.map(async (link) => {
        if (link.dataset.papyrusArtifactBound) return;
        link.dataset.papyrusArtifactBound = "true";
        const type = link.dataset.artifactType;

        if (type !== "mermaid") {
          const note = document.createElement("small");
          note.className = "papyrus-artifact-status";
          note.textContent = type === "plantuml"
            ? "PlantUML needs a local or server renderer before papyrus can show SVG inline."
            : "Excalidraw needs an Excalidraw renderer before papyrus can show the drawing inline.";
          link.querySelector("span")?.append(note);
          return;
        }

        try {
          const response = await fetch(link.href);
          if (!response.ok) return;
          const source = await response.text();
          const diagram = document.createElement("div");
          diagram.className = "papyrus-mermaid";
          diagram.textContent = source.trim();
          link.after(diagram);
        } catch {
          const note = document.createElement("small");
          note.className = "papyrus-artifact-status";
          note.textContent = "Could not load Mermaid source.";
          link.querySelector("span")?.append(note);
        }
      }),
    );
  }

  if (artifactLinksEnabled) await hydrateArtifactLinks();

  let mermaidRenderCounter = 0;
  let mermaidModulePromise: Promise<typeof import("mermaid/dist/mermaid.esm.mjs")> | undefined;

  function mermaidThemeConfig() {
    const styles = getComputedStyle(document.documentElement);
    const bg = styles.getPropertyValue("--papyrus-bg").trim();
    const panel = styles.getPropertyValue("--papyrus-panel").trim();
    const fg = styles.getPropertyValue("--papyrus-fg").trim();
    const muted = styles.getPropertyValue("--papyrus-muted").trim();
    const accent = styles.getPropertyValue("--papyrus-accent").trim();

    return {
      theme: "base" as const,
      themeVariables: {
        background: bg,
        mainBkg: panel,
        primaryColor: accent,
        primaryTextColor: fg,
        primaryBorderColor: accent,
        lineColor: muted,
        textColor: fg,
        darkMode: document.documentElement.classList.contains("dark"),
      },
    };
  }

  async function renderPapyrusMermaidDiagrams() {
    if (!mermaidEnabled) return;

    const mermaidBlocks = Array.from(document.querySelectorAll<HTMLElement>(".papyrus-mermaid"));
    if (mermaidBlocks.length === 0) return;

    mermaidModulePromise ??= import("mermaid/dist/mermaid.esm.mjs");
    const { default: mermaid } = await mermaidModulePromise;

    mermaid.initialize({
      securityLevel: "strict",
      startOnLoad: false,
      ...mermaidThemeConfig(),
    });

    await Promise.all(
      mermaidBlocks.map(async (block, index) => {
        const source = block.dataset.papyrusMermaidSource ?? block.textContent?.trim() ?? "";
        if (!source) return;
        block.dataset.papyrusMermaidSource = source;
        const id = `papyrus-mermaid-${Date.now()}-${mermaidRenderCounter++}-${index}`;

        try {
          const { svg } = await mermaid.render(id, source);
          block.innerHTML = svg;
          block.removeAttribute("role");
          block.dataset.error = "false";
        } catch (error) {
          block.setAttribute("data-error", "true");
          console.error("Failed to render Mermaid diagram", error);
        }
      }),
    );

    if (imageZoomEnabled) bindImageZoom();
  }

  if (mermaidEnabled) {
    await renderPapyrusMermaidDiagrams();
    document.addEventListener("papyrus:theme-change", () => {
      renderPapyrusMermaidDiagrams();
    });
  }

  const ditherVertexShader = `
    attribute vec2 a_position;
    attribute vec2 a_texCoord;
    varying vec2 v_texCoord;
    void main() {
      gl_Position = vec4(a_position, 0.0, 1.0);
      v_texCoord = a_texCoord;
    }
  `;

  const ditherFragmentShader = `
    precision mediump float;
    uniform sampler2D u_video;
    uniform vec2 u_resolution;
    uniform float u_isLight;
    uniform vec3 u_ink;
    uniform vec3 u_background;
    varying vec2 v_texCoord;

    float hash(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    float atkinsonThreshold(vec2 pos) {
      int x = int(mod(pos.x, 4.0));
      int y = int(mod(pos.y, 4.0));
      int idx = y * 4 + x;
      float thresholds[16];
      thresholds[0] = 0.0; thresholds[1] = 12.0; thresholds[2] = 3.0; thresholds[3] = 15.0;
      thresholds[4] = 8.0; thresholds[5] = 4.0; thresholds[6] = 11.0; thresholds[7] = 7.0;
      thresholds[8] = 2.0; thresholds[9] = 14.0; thresholds[10] = 1.0; thresholds[11] = 13.0;
      thresholds[12] = 10.0; thresholds[13] = 6.0; thresholds[14] = 9.0; thresholds[15] = 5.0;
      for (int i = 0; i < 16; i++) {
        if (i == idx) return thresholds[i] / 16.0;
      }
      return 0.0;
    }

    void main() {
      vec4 source = texture2D(u_video, v_texCoord);
      float gray = dot(source.rgb, vec3(0.299, 0.587, 0.114));
      vec2 uv = gl_FragCoord.xy / u_resolution;
      float edgeNoise = hash(gl_FragCoord.xy * 0.5) * 0.15;
      float fade = smoothstep(0.0, 0.1 + edgeNoise, uv.x)
        * smoothstep(0.0, 0.1 + edgeNoise, 1.0 - uv.x)
        * smoothstep(0.0, 0.1 + edgeNoise, uv.y)
        * smoothstep(0.0, 0.1 + edgeNoise, 1.0 - uv.y);
      gray = mix(gray * fade, mix(1.0, gray, fade), u_isLight);
      gray = clamp(gray * 1.2 - 0.1, 0.0, 1.0);
      float threshold = clamp(atkinsonThreshold(gl_FragCoord.xy) + mix(0.1, -0.1, u_isLight), 0.001, 0.999);
      float dithered = step(threshold, gray);
      float inkAlpha = mix(dithered, 1.0 - dithered, u_isLight) * source.a;
      gl_FragColor = vec4(mix(u_background, u_ink, inkAlpha), 1.0);
    }
  `;

  function parseRgb(color: string): [number, number, number] | undefined {
    const match = color.match(/rgba?\(([^)]+)\)/);
    if (!match) return undefined;
    const channels = match[1].split(/[,\s/]+/).filter(Boolean).slice(0, 3).map(Number);
    if (channels.length !== 3 || channels.some(Number.isNaN)) return undefined;
    return [
      Math.min(1, Math.max(0, channels[0] / 255)),
      Math.min(1, Math.max(0, channels[1] / 255)),
      Math.min(1, Math.max(0, channels[2] / 255)),
    ];
  }

  function cssRgb(property: string, fallback: [number, number, number]): [number, number, number] {
    const probe = document.createElement("span");
    probe.style.color = `var(${property})`;
    probe.style.position = "absolute";
    probe.style.visibility = "hidden";
    document.body.append(probe);
    const parsed = parseRgb(getComputedStyle(probe).color);
    probe.remove();
    return parsed ?? fallback;
  }

  function createDitherShader(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type);
    if (!shader) return undefined;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return undefined;
    return shader;
  }

  function initDitheredVideo(video: HTMLVideoElement) {
    if (video.dataset.papyrusVideoDitherBound) return;
    video.dataset.papyrusVideoDitherBound = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion) return;

    const canvas = document.createElement("canvas");
    const gl = canvas.getContext("webgl", { alpha: false, antialias: false, premultipliedAlpha: false }) as WebGLRenderingContext;
    if (!gl) return;

    const vertexShader = createDitherShader(gl, gl.VERTEX_SHADER, ditherVertexShader);
    const fragmentShader = createDitherShader(gl, gl.FRAGMENT_SHADER, ditherFragmentShader);
    if (!vertexShader || !fragmentShader) return;

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vertexShader);
    gl.attachShader(program, fragmentShader);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    const position = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, position);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const positionLocation = gl.getAttribLocation(program, "a_position");
    gl.enableVertexAttribArray(positionLocation);
    gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);

    const texCoord = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, texCoord);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([0, 1, 1, 1, 0, 0, 1, 0]), gl.STATIC_DRAW);
    const texCoordLocation = gl.getAttribLocation(program, "a_texCoord");
    gl.enableVertexAttribArray(texCoordLocation);
    gl.vertexAttribPointer(texCoordLocation, 2, gl.FLOAT, false, 0, 0);

    const texture = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, texture);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.uniform1i(gl.getUniformLocation(program, "u_video"), 0);

    const resolutionLocation = gl.getUniformLocation(program, "u_resolution");
    const isLightLocation = gl.getUniformLocation(program, "u_isLight");
    const inkLocation = gl.getUniformLocation(program, "u_ink");
    const backgroundLocation = gl.getUniformLocation(program, "u_background");

    const frame = document.createElement("span");
    frame.className = "papyrus-video-dither-frame";
    video.before(frame);
    frame.append(video, canvas);
    canvas.className = "papyrus-video-dither-canvas";
    video.classList.add("papyrus-video-dither-source");

    let isVisible = true;
    let needsResize = true;
    let animationFrame = 0;
    let lastFrame = 0;

    function syncTheme() {
      const isLight = document.documentElement.classList.contains("dark") ? 0 : 1;
      const ink = cssRgb("--papyrus-fg", [0, 0, 0]);
      const background = cssRgb("--papyrus-bg", [1, 1, 1]);
      gl.uniform1f(isLightLocation, isLight);
      gl.uniform3f(inkLocation, ink[0], ink[1], ink[2]);
      gl.uniform3f(backgroundLocation, background[0], background[1], background[2]);
    }

    function resize() {
      const rect = frame.getBoundingClientRect();
      const ratio = window.devicePixelRatio || 1;
      const width = Math.max(1, Math.round(rect.width * ratio));
      const height = Math.max(1, Math.round(rect.height * ratio));
      if (canvas.width === width && canvas.height === height) return;
      canvas.width = width;
      canvas.height = height;
      gl.viewport(0, 0, width, height);
      gl.uniform2f(resolutionLocation, width, height);
    }

    function render(timestamp: number) {
      animationFrame = 0;
      if (!isVisible || video.readyState < HTMLMediaElement.HAVE_CURRENT_DATA) return;
      if (timestamp - lastFrame < 80) {
        animationFrame = requestAnimationFrame(render);
        return;
      }
      lastFrame = timestamp;
      if (needsResize) {
        resize();
        needsResize = false;
      }

      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, texture);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, video);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      animationFrame = requestAnimationFrame(render);
    }

    function requestRender() {
      if (!animationFrame && isVisible) animationFrame = requestAnimationFrame(render);
    }

    syncTheme();
    document.addEventListener("papyrus:theme-change", () => {
      syncTheme();
      requestRender();
    });
    window.addEventListener("resize", () => {
      needsResize = true;
      requestRender();
    });
    video.addEventListener("play", requestRender);
    video.addEventListener("loadeddata", requestRender);

    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0]?.isIntersecting ?? true;
      if (isVisible) {
        requestRender();
      } else if (animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    });
    observer.observe(frame);
    video.play().catch(() => undefined);
    requestRender();
  }

  function createDitheredVideo(placeholder: HTMLElement) {
    if (placeholder.dataset.papyrusVideoDitherBound) return;
    placeholder.dataset.papyrusVideoDitherBound = "true";
    const src = placeholder.dataset.papyrusVideoDitherSrc;
    if (!src) return;

    const video = document.createElement("video");
    video.className = "papyrus-video-effect-dither";
    video.src = src;
    video.poster = placeholder.dataset.papyrusVideoDitherPoster ?? "";
    video.autoplay = true;
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.controls = placeholder.dataset.papyrusVideoDitherControls === "true";
    video.setAttribute("aria-label", placeholder.dataset.papyrusVideoDitherLabel ?? "Dithered video");
    placeholder.replaceWith(video);
    initDitheredVideo(video);
  }

  function bindDitheredVideos() {
    if (!videoDitherEnabled) return;
    document.querySelectorAll<HTMLElement>("[data-papyrus-video-dither-src]").forEach(createDitheredVideo);
    document.querySelectorAll<HTMLVideoElement>("video.papyrus-video-effect-dither").forEach(initDitheredVideo);
  }

  bindDitheredVideos();

  if (imageZoomEnabled) bindImageZoom();
</script>
