<script>
  import QRCode from "qrcode";
  import { copyPapyrusText } from "./papyrusClipboard";

  function setActionButtonState(button: HTMLButtonElement, label: string, restore = "Copy code") {
    button.dataset.state = label.toLowerCase().replace(/\s+/g, "-");
    button.setAttribute("aria-label", label);
    const labelElement = button.querySelector<HTMLElement>(".papyrus-button-label");
    if (labelElement) labelElement.textContent = label;
    window.setTimeout(() => {
      button.dataset.state = "";
      button.setAttribute("aria-label", restore);
      if (labelElement) labelElement.textContent = restore;
    }, 1600);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-papyrus-share]").forEach((button) => {
    button.addEventListener("click", async () => {
      const url = window.location.href;
      const title = document.title;
      const description = document.querySelector<HTMLMetaElement>('meta[name="description"]')?.content?.trim();
      const shareData: ShareData = {
        title,
        url,
      };
      if (description) shareData.text = description;

      if (navigator.share && (!navigator.canShare || navigator.canShare(shareData))) {
        try {
          await navigator.share(shareData);
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") return;
        }
      }

      await copyPapyrusText(url, "Copy link");
      setActionButtonState(button, "Copied", "Share");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-papyrus-copy-source]").forEach((button) => {
    button.addEventListener("click", async () => {
      const sourceUrl = button.dataset.papyrusCopySource;
      if (!sourceUrl) return;

      try {
        const response = await fetch(sourceUrl);
        if (!response.ok) throw new Error(`Could not load ${sourceUrl}`);
        const source = await response.text();
        await copyPapyrusText(source, "Copy source");
        setActionButtonState(button, "Copied", "Copy");
      } catch {
        setActionButtonState(button, "Unavailable", "Copy");
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-papyrus-copy-source-link]").forEach((button) => {
    button.addEventListener("click", async () => {
      const sourceUrl = button.dataset.papyrusCopySourceLink;
      if (!sourceUrl) return;

      await copyPapyrusText(sourceUrl, "Copy source link");
      setActionButtonState(button, "Copied", "Source");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-papyrus-copy-citation]").forEach((button) => {
    button.addEventListener("click", async () => {
      const url = button.dataset.papyrusCopyCitation ?? window.location.href;
      const pageTitle = button.dataset.papyrusTitle ?? document.title;
      const citation = `${pageTitle}. ${url}`;
      await copyPapyrusText(citation, "Copy title + link");
      setActionButtonState(button, "Title + link copied", "Copy title + link");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-papyrus-qr]").forEach((button) => {
    const wrapper = button.closest<HTMLElement>(".papyrus-qr-action");
    const popover = wrapper?.querySelector<HTMLElement>("[data-papyrus-qr-popover]");
    if (!wrapper || !popover) return;

    button.addEventListener("click", async () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      if (expanded) {
        button.setAttribute("aria-expanded", "false");
        popover.hidden = true;
        return;
      }

      if (!popover.dataset.papyrusQrReady) {
        const svg = await QRCode.toString(window.location.href, {
          type: "svg",
          errorCorrectionLevel: "M",
          margin: 1,
          width: 164,
        });
        popover.innerHTML = `${svg}<span>${window.location.href}</span>`;
        popover.dataset.papyrusQrReady = "true";
      }

      button.setAttribute("aria-expanded", "true");
      popover.hidden = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || popover.hidden) return;
      button.setAttribute("aria-expanded", "false");
      popover.hidden = true;
      button.focus();
    });

    document.addEventListener("click", (event) => {
      if (popover.hidden || wrapper.contains(event.target as Node)) return;
      button.setAttribute("aria-expanded", "false");
      popover.hidden = true;
    });
  });
</script>
