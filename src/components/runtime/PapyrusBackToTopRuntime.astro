---
import { BackToTop } from "astro-pure/components/pages";
---

<div class="papyrus-pure-back-to-top">
  <BackToTop header="papyrus-post-top-sentinel" content="papyrus-post-content" />
</div>

<script is:inline data-astro-rerun>
  document.querySelector("#to-top-btn")?.setAttribute("data-papyrus-back-to-top", "");
</script>

<style is:global>
  .papyrus-pure-back-to-top #action-buttons {
    bottom: 22px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: fixed;
    right: 22px;
    transition: transform 150ms ease;
    z-index: 50;
  }

  .papyrus-pure-back-to-top #to-top-btn {
    align-items: center;
    background: color-mix(in srgb, var(--papyrus-bg) 88%, transparent);
    border: 2px solid transparent;
    border-radius: 50%;
    box-shadow: 0 18px 42px color-mix(in srgb, var(--papyrus-fg) 18%, transparent);
    color: var(--papyrus-muted);
    cursor: pointer;
    display: flex;
    height: 54px;
    justify-content: center;
    opacity: 0;
    position: relative;
    transition: border-color 150ms ease, color 150ms ease, opacity 150ms ease;
    width: 54px;
  }

  .papyrus-pure-back-to-top #action-buttons.show #to-top-btn {
    opacity: 1;
  }

  .papyrus-pure-back-to-top #to-top-btn:hover,
  .papyrus-pure-back-to-top #to-top-btn:focus-visible {
    border-color: var(--papyrus-border);
    color: var(--papyrus-accent);
    outline: none;
  }

  .papyrus-pure-back-to-top #to-top-btn .top-text,
  .papyrus-pure-back-to-top #to-top-btn .top-icon {
    align-items: center;
    display: flex;
    inset: 0;
    justify-content: center;
    position: absolute;
  }

  .papyrus-pure-back-to-top #to-top-btn .top-icon {
    height: 20px;
    margin: auto;
    width: 20px;
  }

  @media (max-width: 719px) {
    .papyrus-pure-back-to-top #action-buttons {
      bottom: 20px;
    }
  }
</style>
