---
import { formatPostDate, postHref } from "../utils/posts";

interface PostItem {
  id: string;
  data: {
    title: string;
    slug?: string;
    pubDatetime?: Date | string;
    date?: Date | string;
  };
}

interface Props {
  posts: PostItem[];
  basePath?: string;
  openYearWindow?: number;
}

const { posts, basePath = "/posts", openYearWindow = 2 } = Astro.props;
const currentYear = new Date().getFullYear();
const firstCollapsedYear = currentYear - openYearWindow + 1;

function href(post: PostItem) {
  return postHref(post, basePath);
}

function yearOf(post: PostItem) {
  return new Date(post.data.pubDatetime ?? post.data.date ?? 0).getFullYear();
}

function dateOf(post: PostItem) {
  return formatPostDate(post.data.pubDatetime ?? post.data.date);
}

const groups = Map.groupBy(posts, yearOf);
---

<div class="paper-archive-list">
  {
    Array.from(groups.entries()).map(([year, yearPosts]) => (
      <details class="paper-archive-year" open={year >= firstCollapsedYear}>
        <summary>
          <h2>{year}</h2>
          <span>{yearPosts.length}</span>
        </summary>
        <ul>
          {yearPosts.map(post => (
            <li>
              <time>{dateOf(post)}</time>
              <a href={href(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</div>
