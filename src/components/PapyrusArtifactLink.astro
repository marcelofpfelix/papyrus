---
interface Props {
  href: string;
  label: string;
  type?: "mermaid" | "plantuml" | "excalidraw" | "file";
  description?: string;
}

const {
  href,
  label,
  type = "file",
  description,
} = Astro.props;

function icon(name: string) {
  const icons: Record<string, string> = {
    excalidraw: `<path d="M4 19 19 4"></path><path d="m14 4 6 6"></path><path d="M5 20h4l11-11-4-4L5 16z"></path>`,
    file: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path>`,
    mermaid: `<path d="M4 18c4-10 12-10 16 0"></path><path d="M4 6c4 10 12 10 16 0"></path><path d="M4 12h16"></path>`,
    plantuml: `<path d="M4 20V4h16v16z"></path><path d="M8 8h8"></path><path d="M8 12h8"></path><path d="M8 16h5"></path>`,
  };

  return icons[name] ?? icons.file;
}
---

<a class="papyrus-artifact-link" href={href}>
  <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon(type)} />
  <span>
    <strong>{label}</strong>
    {description && <small>{description}</small>}
  </span>
</a>

