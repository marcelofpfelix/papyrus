---
import { withBase } from "../utils/withBase";

interface ContentIndexItem {
  id?: string;
  title: string;
  href?: string;
  description?: string;
  source?: "doc" | "post";
  current?: boolean;
  children?: ContentIndexItem[];
}

interface Props {
  items: ContentIndexItem[];
}

const { items } = Astro.props;

function icon(name: string) {
  const icons: Record<string, string> = {
    file: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path>`,
    folder: `<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"></path>`,
  };

  return icons[name] ?? "";
}
---

<ul class="papyrus-content-index">
  {
    items.map(item => (
      <li id={item.id} class:list={{ "is-current": item.current }}>
        <div class="papyrus-content-index-row">
          <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon(item.children?.length ? "folder" : "file")} />
          <span>
            {item.href ? <a href={withBase(item.href)} aria-current={item.current ? "page" : undefined}>{item.title}</a> : item.title}
            {item.description && <small>{item.description}</small>}
          </span>
        </div>
        {item.children?.length ? <Astro.self items={item.children} /> : null}
      </li>
    ))
  }
</ul>
