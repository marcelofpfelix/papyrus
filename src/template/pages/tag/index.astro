---
import { getCollection } from "astro:content";
import { PapyrusBaseLayout, PapyrusTagList } from "../../../components";
import { getAllTags, publishedPosts } from "../../../utils";
import { getTemplateSite } from "../../site";

const site = await getTemplateSite();
const tags = getAllTags(publishedPosts(await getCollection("posts")));
---

<PapyrusBaseLayout title="Tags" description="Browse posts by tag." siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="papyrus-hero">
    <h1>Tags</h1>
    <p class="papyrus-description">Topics used by the public posts.</p>
  </section>
  <PapyrusTagList tags={tags} />
</PapyrusBaseLayout>
