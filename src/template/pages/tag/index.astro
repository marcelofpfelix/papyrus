---
import { getCollection } from "astro:content";
import { PapyrusBaseLayout, PapyrusTagList } from "../../../components";
import { pageDescription, pageMetaDescription } from "../../../config";
import { getAllTags, postsByTag, publishedPosts } from "../../../utils";
import { withBase } from "../../../utils/withBase";
import { getTemplateSite } from "../../site";

const site = await getTemplateSite();
const posts = publishedPosts(await getCollection("posts"));
const tags = getAllTags(posts);
const counts = Object.fromEntries(
  tags.map(tag => [tag, postsByTag(posts, tag).length])
);
const description = pageDescription(site, "tags", "Topics used by the public posts.");
const metaDescription = pageMetaDescription(site, "tags", "Topics used by the public posts.");
---

<PapyrusBaseLayout title="Tags" description={metaDescription} siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="papyrus-hero">
    <p class="papyrus-post-back">
      <a href={withBase("/posts/")}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <span>Back</span>
      </a>
    </p>
    <h1>Tags</h1>
    {description && <p class="papyrus-description">{description}</p>}
  </section>
  <section class="papyrus-section">
    <PapyrusTagList tags={tags} counts={counts} />
  </section>
</PapyrusBaseLayout>
