---
import { PapyrusCvActions } from "../../../components";
import { githubSourceUrl } from "../../../config";
import { cvIconSvg, cvLinkIcon } from "../../../utils/cv-icons";
import { compactDurationLabel, profileLinkKindLabel } from "../../../utils/cv-profile-data";
import { shouldShowCvItemTitle } from "../../../utils/cv";
import { withBase } from "../../../utils/withBase";
import { getTemplateProfileData } from "../../profile";
import { getTemplateSite } from "../../site";
import "../../../styles/cv-print.css";

const site = await getTemplateSite();
const { cvSections, printProfileLinks, profile, profilePages } = await getTemplateProfileData();
const pages = profilePages;
const currentCvHref = profile.canonicalCv;
const cvMarkdownHref = withBase("/cv/profile.md");
const profileSourceLinks = [
  { label: "TOML", href: githubSourceUrl(site, "src/data/profile.toml") },
  { label: "JSON", href: githubSourceUrl(site, "public/cv/profile.json") },
  { label: "Markdown", href: githubSourceUrl(site, "public/cv/profile.md") },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
const profileVersionLinks = [
  { label: "Modern", href: withBase("/profile/print/") },
  { label: "Classic", href: withBase("/profile/ast/") },
];

function cvIcon(name: string) {
  const icons: Record<string, string> = {
    award: `<circle cx="12" cy="8" r="5"></circle><path d="M8.5 12.5 7 22l5-3 5 3-1.5-9.5"></path>`,
    briefcase: `<rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>`,
    hands: `<path d="M7 11v4a4 4 0 0 0 8 0v-4"></path><path d="M5 11h14"></path><path d="M9 7V4"></path><path d="M15 7V4"></path>`,
    school: `<path d="m22 10-10-5-10 5 10 5 10-5Z"></path><path d="M6 12v5c3 2 9 2 12 0v-5"></path>`,
    tools: `<path d="m14.7 6.3 3-3a3.5 3.5 0 0 1-4.9 4.9l-6.6 6.6a2 2 0 1 0 2.8 2.8l6.6-6.6a3.5 3.5 0 0 1 4.9-4.9l-3 3"></path>`,
    university: `<path d="m3 10 9-6 9 6"></path><path d="M5 10h14"></path><path d="M6 10v8"></path><path d="M10 10v8"></path><path d="M14 10v8"></path><path d="M18 10v8"></path><path d="M4 18h16"></path>`,
    user: `<circle cx="12" cy="8" r="4"></circle><path d="M4 22a8 8 0 0 1 16 0"></path>`,
  };

  return icons[name] ?? icons.user;
}

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Printable CV for ${profile.name}`} />
    <link rel="icon" href={profile.favicon} />
    <title>{profile.name} - Printable CV</title>
  </head>
  <body style={`--profile-print-color: ${profile.printColor};`}>
    <PapyrusCvActions
      backHref={withBase("/profile/")}
      print
      markdownHref={cvMarkdownHref}
      shareText={profile.headline}
      sourceLinks={profileSourceLinks}
      versionLinks={profileVersionLinks}
    />

    <main aria-label={`${profile.name} printable CV`}>
      {pages.map(page => (
        <section class="sheet" aria-label={`CV page ${page}`}>
          <article class="print-cv">
            {page === 1 && (
              <>
                <header class="print-profile">
                  <div class="print-avatar">
                    <img src={profile.avatar} alt={profile.name} />
                    <h1>{profile.name}</h1>
                    <p>{profile.headline}</p>
                  </div>
                  <div class="print-profile-details">
                    <section>
                      <h2>Contact</h2>
                      {printProfileLinks.map(link => (
                        <p>
                          <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvLinkIcon(link)} />
                          <strong>{profileLinkKindLabel(link)}:</strong>
                          {link.emailParts ? (
                            <span class="print-email-parts">
                              <span>{link.emailParts.user}</span><span class="print-email-at" aria-hidden="true"></span><span>{link.emailParts.domainParts.join(".")}</span>
                            </span>
                          ) : (
                            <span>{link.label}</span>
                          )}
                        </p>
                      ))}
                    </section>
                    <section>
                      <h2>Info</h2>
                      {profile.meta.map(item => (
                        <p>
                          <svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIconSvg(item.icon)} />
                          <span>{item.value}</span>
                        </p>
                      ))}
                    </section>
                  </div>
                </header>
                <p class="print-info">
                  You can always find this CV updated at <a href={currentCvHref}>{currentCvHref}</a>.
                </p>
              </>
            )}

            {cvSections.filter(section => section.page === page).map(section => (
              <section class="print-section">
                <h2>
                  <span><svg aria-hidden="true" viewBox="0 0 24 24" set:html={cvIcon(section.icon)} /></span>
                  {section.title}
                  {section.duration && <small>{compactDurationLabel(section.duration)}</small>}
                </h2>
                {section.groups.map(group => (
                  <article class="print-group">
                    {group.entity && (
                      <a class="print-entity" href={group.url}>
                        {group.logo && <img src={group.logo} alt="" />}
                        <strong>{group.entity}</strong>
                      </a>
                    )}
                    {group.items.map(item => (
                      <section class="print-item">
                        {(shouldShowCvItemTitle(section, group, item) || item.location || item.dates || item.duration) && (
                          <header>
                            {shouldShowCvItemTitle(section, group, item) && <h3>{item.title}</h3>}
                            {(item.location || item.dates || item.duration) && (
                              <p>{[item.location, item.dates, compactDurationLabel(item.duration)].filter(Boolean).join(", ")}</p>
                            )}
                          </header>
                        )}
                        {item.description && <div class="print-description" set:html={item.description} />}
                      </section>
                    ))}
                  </article>
                ))}
              </section>
            ))}

            <footer>made with <a href="https://github.com/marcelofpfelix/papyrus">github.com/marcelofpfelix/papyrus</a></footer>
          </article>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
  }

  * {
    box-sizing: border-box;
  }

  body {
    color: #18181b;
    font-family: "Open Sans", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 10pt;
    line-height: 1.36;
    margin: 0;
  }

  .sheet {
    background: #fff;
    box-shadow: 0 12px 36px rgb(24 24 27 / 0.18);
    height: 296mm;
    margin: 10mm auto;
    overflow: hidden;
    padding: 10mm;
    position: relative;
    width: 210mm;
  }

  .print-info {
    background: #dbeafe;
    border-radius: 5px;
    margin: 8px auto;
    padding: 6px 10px;
    width: 190mm;
  }

  .print-info a,
  .print-cv a {
    color: inherit;
    font-weight: inherit;
    text-decoration: none;
  }

  .print-info a:hover,
  .print-info a:focus-visible,
  .print-cv a:hover,
  .print-cv a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .print-cv {
    height: 100%;
    position: relative;
  }

  .print-profile {
    display: grid;
    gap: 0;
    grid-template-columns: 45mm 1fr;
    margin-bottom: 10px;
  }

  .print-avatar {
    background: #e4e4e7;
    min-height: 45mm;
    padding: 5mm;
    text-align: center;
  }

  .print-avatar img {
    border: 2px solid #71717a;
    border-radius: 999px;
    height: 24mm;
    object-fit: cover;
    width: 24mm;
  }

  .print-avatar h1 {
    color: #18181b;
    font-size: 15pt;
    line-height: 1;
    margin: 3mm 0 1mm;
  }

  .print-avatar p {
    font-size: 8.5pt;
    margin: 0;
  }

  .print-profile-details {
    background: #f4f4f5;
    display: grid;
    gap: 3mm;
    grid-template-columns: 1fr 1fr;
    min-height: 45mm;
    padding: 4mm 5mm;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  .print-profile-details h2,
  .print-section h2 {
    color: var(--profile-print-color);
  }

  .print-profile-details h2 {
    font-size: 11pt;
    margin-bottom: 3px;
  }

  .print-profile-details p {
    font-size: 8.5pt;
    line-height: 1.2;
    margin-bottom: 2px;
  }

  .print-profile-details p {
    align-items: center;
    display: flex;
    gap: 5px;
    min-height: 0;
  }

  .print-profile-details p svg {
    color: var(--profile-print-color);
    flex: 0 0 auto;
    height: 0.95em;
    width: 0.95em;
  }

  .print-email-at::before {
    content: "@";
  }

  .print-info {
    font-size: 8.5pt;
    margin-bottom: 8px;
    text-align: center;
    width: auto;
  }

  .print-section {
    margin-top: 8px;
  }

  .print-section h2 {
    align-items: center;
    display: flex;
    font-size: 13pt;
    font-weight: 500;
    gap: 6px;
    margin-bottom: 4px;
  }

  .print-section h2 small {
    color: #71717a;
    font-size: 8pt;
    font-weight: 600;
    margin-left: auto;
  }

  .print-section h2 span {
    align-items: center;
    color: var(--profile-print-color);
    display: inline-flex;
  }

  .print-section h2 svg {
    fill: none;
    height: 10pt;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: 10pt;
  }

  .print-group + .print-group {
    margin-top: 5px;
  }

  .print-entity {
    align-items: center;
    display: inline-flex;
    gap: 5px;
    margin-bottom: 3px;
    min-height: 44px;
  }

  .print-entity img {
    border-radius: 4px;
    height: 10mm;
    object-fit: contain;
    width: 10mm;
  }

  .print-item header {
    align-items: baseline;
    display: flex;
    gap: 8px;
    justify-content: space-between;
  }

  .print-item h3 {
    color: #3f3f46;
    font-size: 10pt;
    margin-bottom: 2px;
  }

  .print-item header p {
    color: #3f3f46;
    font-size: 8.5pt;
    margin-bottom: 2px;
    text-align: right;
  }

  .print-description,
  .print-description :global(li) {
    font-size: 8.7pt;
  }

  .print-description :global(ul) {
    margin: 0;
    padding-left: 14px;
  }

  .print-description :global(p) {
    margin-bottom: 3px;
  }

  footer {
    bottom: 0;
    color: #52525b;
    font-size: 8pt;
    left: 0;
    position: absolute;
    right: 0;
    text-align: center;
  }

  @media print {
    .sheet {
      box-shadow: none;
      margin: 0;
    }

    .cv-download button,
    .print-profile-details p,
    .print-entity {
      min-height: 0;
    }

    .no-print {
      display: none;
    }
  }
</style>
