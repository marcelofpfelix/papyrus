---
import { getCollection } from "astro:content";
import PapyrusProfilePage from "../../../components/PapyrusProfilePage.astro";
import { githubSourceUrl } from "../../../config";
import { getAllTags, publishedPosts } from "../../../utils";
import { getTemplateProfileData } from "../../profile";
import { getTemplateSite } from "../../site";

const site = await getTemplateSite();
const profileData = await getTemplateProfileData();
const availablePostTags = getAllTags(publishedPosts(await getCollection("posts")));
const profileSourceLinks = [
  { label: "TOML", href: githubSourceUrl(site, "src/data/profile.toml") },
  { label: "JSON", href: githubSourceUrl(site, "public/cv/profile.json") },
  { label: "JSON Resume", href: githubSourceUrl(site, "public/cv/resume.json") },
  { label: "Markdown", href: githubSourceUrl(site, "public/cv/profile.md") },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
const profileVersionLinks = [
  { label: "Modern", href: "/profile/print/" },
  { label: "Classic", href: "/profile/ast/" },
];
---

<PapyrusProfilePage
  site={site}
  {...profileData}
  sourceLinks={profileSourceLinks}
  versionLinks={profileVersionLinks}
  availablePostTags={availablePostTags}
/>
