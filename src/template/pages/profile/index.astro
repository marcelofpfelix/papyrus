---
import { PaperBaseLayout, PaperCvProfile } from "../../../components";
import { getTemplateProfile } from "../../profile";
import { getTemplateSite } from "../../site";

const site = await getTemplateSite();
const profile = await getTemplateProfile();
---

<PaperBaseLayout title="Profile" description={profile.bio} siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="paper-hero">
    <h1>Profile</h1>
    <p class="paper-description">{profile.bio}</p>
  </section>
  <PaperCvProfile user={profile} variant="cards" showSource={true} sourceHref="/cv/profile.md" />
</PaperBaseLayout>
