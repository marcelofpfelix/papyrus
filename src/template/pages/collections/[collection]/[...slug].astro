---
import { getCollection, render } from "astro:content";
import { PapyrusCollectionIndex } from "../../../../components";
import PapyrusPostLayout from "../../../../layouts/PapyrusPostLayout.astro";
import { collectionOrderedPosts, collectionPostSlug, collectionTocLinks, getPostCollections } from "../../../../utils/collections";
import { postHref, postSlug, type PapyrusPostEntry } from "../../../../utils/posts";
import { templatePostLayoutProps } from "../../../post";
import { getTemplateSite } from "../../../site";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const postsBySlug = new Map(allPosts.map(post => [postSlug(post), post]));
  const collections = await getPostCollections("src/content/posts", allPosts);

  return collections.flatMap(collection => collectionOrderedPosts(collection).flatMap((collectionPost, index, orderedPosts) => {
    const postSlugValue = postSlug(collectionPost);
    const post = postsBySlug.get(postSlugValue);
    if (!post) return [];

    const adjacentPost = (entry: PapyrusPostEntry | undefined) => entry
      ? { ...entry, data: { ...entry.data, slug: collectionPostSlug(collection, entry) } }
      : undefined;

    return {
      params: {
        collection: collection.slug,
        slug: collectionPostSlug(collection, post),
      },
      props: {
        post,
        collection,
        adjacent: {
          previous: adjacentPost(index > 0 ? orderedPosts[index - 1] : undefined),
          next: adjacentPost(index < orderedPosts.length - 1 ? orderedPosts[index + 1] : undefined),
        },
      },
    };
  }));
}

const site = await getTemplateSite();
const { post, collection, adjacent } = Astro.props;
const { Content, headings } = await render(post);
const slug = postSlug(post);
const collectionBasePath = `/collections/${collection.slug}`;
const showCollectionFooter = collection.settings.postFooter !== "none";
const collectionFooterCollapsible = collection.settings.postFooterCollapsible;
const postLayoutProps = templatePostLayoutProps(post, site);
const collectionLinks = [
  { href: collection.href, title: "View collection", depth: 2 },
  ...collectionTocLinks(collection, collectionBasePath),
];
---

<PapyrusPostLayout {...postLayoutProps} headings={headings} tocLinks={collectionLinks} showToc={true} canonicalUrl={postHref(post)} previous={adjacent.previous} next={adjacent.next} adjacentBasePath={collectionBasePath} backHref={`${collectionBasePath}/`} morePostsHref={`${collectionBasePath}/`}>
  <Content />

  {showCollectionFooter && (
  <Fragment slot="after">
    <section id="collection-posts" class="papyrus-section papyrus-collection-footer">
      {collectionFooterCollapsible ? (
        <details class="papyrus-collection-footer-details">
          <summary><h2>{collection.name}</h2></summary>
          <PapyrusCollectionIndex collection={collection} basePath={collectionBasePath} showDescriptions={false} currentSlug={slug} />
        </details>
      ) : (
        <>
          <h2>{collection.name}</h2>
          <PapyrusCollectionIndex collection={collection} basePath={collectionBasePath} showDescriptions={false} currentSlug={slug} />
        </>
      )}
    </section>
  </Fragment>
  )}
</PapyrusPostLayout>
