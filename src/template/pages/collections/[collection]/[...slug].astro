---
import { getCollection, render } from "astro:content";
import { PapyrusCollectionIndex } from "../../../../components";
import PapyrusPostLayout from "../../../../layouts/PapyrusPostLayout.astro";
import { collectionOrderedPosts, collectionTocLinks, getPostCollections } from "../../../../utils/collections";
import { postSlug, postTags, readingTime } from "../../../../utils/posts";
import { getTemplateSite } from "../../../site";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const postsBySlug = new Map(allPosts.map(post => [postSlug(post), post]));
  const collections = await getPostCollections("src/content/posts", allPosts);

  return collections.flatMap(collection => collectionOrderedPosts(collection).flatMap((collectionPost, index, orderedPosts) => {
    const slug = postSlug(collectionPost);
    const post = postsBySlug.get(slug);
    if (!post) return [];

    return {
      params: {
        collection: collection.slug,
        slug,
      },
      props: {
        post,
        collection,
        adjacent: {
          previous: index > 0 ? orderedPosts[index - 1] : undefined,
          next: index < orderedPosts.length - 1 ? orderedPosts[index + 1] : undefined,
        },
      },
    };
  }));
}

const site = await getTemplateSite();
const { post, collection, adjacent } = Astro.props;
const { Content, headings } = await render(post);
const slug = postSlug(post);
const collectionBasePath = `/collections/${collection.slug}`;
const showCollectionFooter = collection.settings.postFooter !== "none";
const collectionFooterCollapsible = collection.settings.postFooterCollapsible;
const collectionLinks = [
  { href: collection.href, title: "View collection", depth: 2 },
  ...collectionTocLinks(collection, collectionBasePath),
];
---

<PapyrusPostLayout title={post.data.title} description={post.data.description} siteTitle={site.title} pubDatetime={post.data.pubDatetime} modDatetime={post.data.modDatetime} cover={post.data.cover} tags={postTags(post)} readingTime={readingTime(post.body)} headings={headings} tocLinks={collectionLinks} showToc={true} canonicalUrl={`${collectionBasePath}/${slug}/`} robots={post.data.robots} previous={adjacent.previous} next={adjacent.next} adjacentBasePath={collectionBasePath} backHref={`${collectionBasePath}/`} morePostsHref={`${collectionBasePath}/`} nav={site.nav} socialLinks={site.socialLinks}>
  <Content />

  {showCollectionFooter && (
  <Fragment slot="after">
    <section id="collection-posts" class="papyrus-section papyrus-collection-footer">
      {collectionFooterCollapsible ? (
        <details class="papyrus-collection-footer-details">
          <summary><h2>{collection.name}</h2></summary>
          <PapyrusCollectionIndex collection={collection} basePath={collectionBasePath} showDescriptions={false} currentSlug={slug} />
        </details>
      ) : (
        <>
          <h2>{collection.name}</h2>
          <PapyrusCollectionIndex collection={collection} basePath={collectionBasePath} showDescriptions={false} currentSlug={slug} />
        </>
      )}
    </section>
  </Fragment>
  )}
</PapyrusPostLayout>
