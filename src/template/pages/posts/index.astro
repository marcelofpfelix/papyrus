---
import { getCollection } from "astro:content";
import { PaperBaseLayout, PaperPostList } from "../../../components";
import { publishedPosts } from "../../../utils";
import { getTemplateSite } from "../../site";

const site = await getTemplateSite();
const posts = publishedPosts(await getCollection("posts")).slice(0, site.postCard.limit ?? 20);
---

<PaperBaseLayout title="Posts" description="All public posts." siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="paper-hero">
    <h1>Posts</h1>
    <p class="paper-description">The public posts in this Papyrus site.</p>
  </section>
  <PaperPostList posts={posts} showTags={site.postCard.tags} showReadTime={site.postCard.readTime} />
</PaperBaseLayout>
