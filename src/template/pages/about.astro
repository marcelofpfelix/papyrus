---
import { PapyrusBaseLayout, PapyrusProjectList } from "../../components";
import { getTemplateProfile } from "../profile";
import { getTemplateSite } from "../site";

const site = await getTemplateSite();
const profile = await getTemplateProfile();
const description = profile.bio || site.description;
const projects = site.projects.slice(0, 3);
---

<PapyrusBaseLayout title="About" description={description} siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features} googleVerification={site.googleVerification}>
  <section class="papyrus-hero">
    <h1>About</h1>
    {description && <p class="papyrus-description">{description}</p>}
  </section>

  <section class="papyrus-section">
    <h2>{profile.name}</h2>
    {profile.bio && <p class="papyrus-description">{profile.bio}</p>}
    <p><a href="/profile/">Profile</a></p>
  </section>

  {projects.length > 0 && (
    <section class="papyrus-section">
      <h2>Projects</h2>
      <PapyrusProjectList projects={projects} />
    </section>
  )}

  <section class="papyrus-section">
    <h2>Posts</h2>
    <p><a href="/posts/">Posts</a></p>
  </section>
</PapyrusBaseLayout>
