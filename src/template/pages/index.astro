---
import { getCollection } from "astro:content";
import { PapyrusBaseLayout, PapyrusPostList, PapyrusProjectList } from "../../components";
import { pageDescription, pageMetaDescription } from "../../config";
import { papyrusSiteSocialImage, publishedPosts, scheduledListPosts, sortPostsWithPinned, withBase } from "../../utils";
import { getTemplateSite } from "../site";

const site = await getTemplateSite();
const homeTitle = site.homeTitle ?? site.title;
const description = pageDescription(site, "home", site.description);
const metaDescription = pageMetaDescription(site, "home", site.description);
const posts = scheduledListPosts(sortPostsWithPinned(publishedPosts(await getCollection("posts"))), 3);
const projects = site.projects.slice(0, site.home.projectLimit);
---

<PapyrusBaseLayout title={site.title} description={metaDescription} siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} ogImage={papyrusSiteSocialImage} ogImageAlt={site.title} nav={site.nav} socialLinks={site.socialLinks} features={site.features} googleVerification={site.googleVerification}>
  <section class="papyrus-hero papyrus-home-hero">
    <h1>{homeTitle}</h1>
    {description && <p class="papyrus-description">{description}</p>}
    <p class="papyrus-home-more">
      <a href={withBase("/about/")}>about me</a>
    </p>
  </section>

  <section class="papyrus-section">
    <h2>Posts</h2>
    <PapyrusPostList posts={posts} showTags={site.postCard.tags} showReadTime={site.postCard.readTime} />
    <p class="papyrus-section-more">
      <a href={withBase("/posts/")}>more posts</a>
    </p>
  </section>

  <section class="papyrus-section">
    <h2>Projects</h2>
    <PapyrusProjectList projects={projects} />
    <p class="papyrus-section-more">
      <a href={withBase("/projects/")}>more projects</a>
    </p>
  </section>
</PapyrusBaseLayout>
