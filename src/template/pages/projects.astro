---
import { PapyrusBaseLayout, PapyrusProjectList } from "../../components";
import { pageDescription } from "../../config";
import { getTemplateSite } from "../site";

const site = await getTemplateSite();
const description = pageDescription(site, "projects", "Two project cards configured in papyrus.config.toml.");
---

<PapyrusBaseLayout title="Projects" description={description} siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="papyrus-hero">
    <h1>Projects</h1>
    {description && <p class="papyrus-description">{description}</p>}
  </section>
  <PapyrusProjectList projects={site.projects.slice(0, 2)} />
</PapyrusBaseLayout>
