---
import { PapyrusBaseLayout, PapyrusProjectList } from "../../components";
import { getTemplateSite } from "../site";

const site = await getTemplateSite();
---

<PapyrusBaseLayout title="Projects" description="Selected projects." siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="papyrus-hero">
    <h1>Projects</h1>
    <p class="papyrus-description">Two project cards configured in <code>papyrus.config.toml</code>.</p>
  </section>
  <PapyrusProjectList projects={site.projects.slice(0, 2)} />
</PapyrusBaseLayout>
