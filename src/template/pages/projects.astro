---
import { PaperBaseLayout, PaperProjectList } from "../../components";
import { getTemplateSite } from "../site";

const site = await getTemplateSite();
---

<PaperBaseLayout title="Projects" description="Selected projects." siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="paper-hero">
    <h1>Projects</h1>
    <p class="paper-description">Two project cards configured in <code>paper.config.toml</code>.</p>
  </section>
  <PaperProjectList projects={site.projects.slice(0, 2)} />
</PaperBaseLayout>
