---
import { PapyrusBaseLayout, PapyrusProjectList } from "../../components";
import { pageDescription, pageMetaDescription } from "../../config";
import { getTemplateSite } from "../site";

const site = await getTemplateSite();
const description = pageDescription(site, "projects", "Project cards from src/data/projects.toml.");
const metaDescription = pageMetaDescription(site, "projects", "Project cards from src/data/projects.toml.");
---

<PapyrusBaseLayout title="Projects" description={metaDescription} siteTitle={site.title} brandTitle={site.brandTitle} brandMark={site.brandMark} showBrandTitle={site.showBrandTitle} defaultThemeProfile={site.defaultThemeProfile} defaultFontProfile={site.defaultFontProfile} nav={site.nav} socialLinks={site.socialLinks} features={site.features}>
  <section class="papyrus-hero">
    <h1>Projects</h1>
    {description && <p class="papyrus-description">{description}</p>}
  </section>
  <PapyrusProjectList projects={site.projects} />
</PapyrusBaseLayout>
