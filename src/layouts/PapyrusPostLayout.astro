---
import PapyrusBaseLayout from "./PapyrusBaseLayout.astro";
import PapyrusAdjacentPosts from "../components/PapyrusAdjacentPosts.astro";
import PapyrusAiMetadata from "../components/PapyrusAiMetadata.astro";
import PapyrusToc from "../components/PapyrusToc.astro";
import PapyrusBackToTopRuntime from "../components/runtime/PapyrusBackToTopRuntime.astro";
import PapyrusMediaRuntime from "../components/runtime/PapyrusMediaRuntime.astro";
import PapyrusPostActionsRuntime from "../components/runtime/PapyrusPostActionsRuntime.astro";
import { resolvePapyrusFeatures, type PapyrusFeatureConfig } from "../utils/features";
import { formatPostDate, tagHref, toTransitionName } from "../utils/posts";
import { getAssetPath, withBase } from "../utils/withBase";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface TocLink {
  href: string;
  title: string;
  depth?: number;
}

interface Props {
  title: string;
  description?: string;
  siteTitle: string;
  headerTitle?: string;
  brandTitle?: string;
  brandMark?: "twinkle" | "terminal";
  brandAriaLabel?: string;
  showBrandTitle?: boolean;
  defaultThemeProfile?: string;
  defaultFontProfile?: string;
  pubDatetime?: Date | string;
  modDatetime?: Date | string;
  date?: Date | string;
  tags?: string[];
  readingTime?: string;
  headings?: Heading[];
  tocLinks?: TocLink[];
  showToc?: boolean;
  tocCollapsed?: boolean;
  cover?: string;
  coverEffect?: "none" | "tricolor";
  cover_effect?: "none" | "tricolor";
  editUrl?: string;
  canonicalUrl?: string;
  sourceUrl?: string;
  sourceLinkUrl?: string;
  robots?: string;
  googleVerification?: string;
  author?: { name: string; url?: string };
  aiMetadata?: boolean;
  backHref?: string | false;
  backLabel?: string;
  moreAboutHref?: string;
  moreAboutLabel?: string;
  morePostsHref?: string;
  morePostsLabel?: string;
  previous?: { id: string; data: { title: string } };
  next?: { id: string; data: { title: string } };
  adjacentBasePath?: string;
  nav?: Array<{ href: string; label: string }>;
  socialLinks?: Array<{ href: string; label: string; icon?: string }>;
  features?: PapyrusFeatureConfig;
  share?: boolean;
  commentsCount?: number;
  viewsCount?: number;
  frontmatter?: Partial<Props>;
}

const props = {
  ...(Astro.props.frontmatter ?? {}),
  ...Astro.props,
} as Props;

const {
  title,
  description = "",
  siteTitle,
  headerTitle,
  brandTitle,
  brandMark,
  brandAriaLabel,
  showBrandTitle,
  defaultThemeProfile,
  defaultFontProfile,
  pubDatetime,
  modDatetime,
  date,
  tags = [],
  readingTime,
  headings = [],
  tocLinks = [],
  showToc = false,
  tocCollapsed = true,
  cover,
  coverEffect,
  cover_effect,
  editUrl,
  canonicalUrl,
  sourceUrl,
  sourceLinkUrl,
  robots,
  googleVerification,
  author,
  aiMetadata = true,
  backHref = "/posts/",
  backLabel = "Back",
  moreAboutHref,
  moreAboutLabel = "more about me",
  morePostsHref = "/posts/",
  morePostsLabel = "more posts",
  previous,
  next,
  adjacentBasePath = "/posts",
  nav = [],
  socialLinks = [],
  features,
  share = true,
  commentsCount,
  viewsCount,
} = props;

const resolvedFeatures = resolvePapyrusFeatures({
  share,
  aiMetadata,
  toc: showToc,
  ...features,
});
const published = pubDatetime ?? date;
const formattedDate = formatPostDate(published);
const formattedUpdated = formatPostDate(modDatetime);
const showUpdated = Boolean(formattedUpdated && formattedUpdated !== formattedDate);
const showPostMeta = Boolean(formattedDate || showUpdated || readingTime);
const resolvedSourceLinkUrl = sourceLinkUrl ?? editUrl ?? sourceUrl;
const showPostActions = Boolean((resolvedFeatures.sourceActions && (editUrl || sourceUrl || sourceLinkUrl)) || resolvedFeatures.share);
const showPostFooter = Boolean(showPostMeta || (resolvedFeatures.postTags && tags.length > 0));
const resolvedCoverEffect = coverEffect ?? cover_effect ?? "none";
const coverEffectClass = resolvedCoverEffect === "none" ? undefined : `papyrus-image-effect-${resolvedCoverEffect}`;
const shouldIndexWithPagefind = !robots?.toLowerCase().includes("noindex");
const sideLinks = [
  moreAboutHref && { href: moreAboutHref, label: moreAboutLabel },
  morePostsHref && { href: morePostsHref, label: morePostsLabel },
].filter(Boolean) as Array<{ href: string; label: string }>;

function icon(name: string) {
  const icons: Record<string, string> = {
    arrowLeft: `<path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>`,
    arrowUp: `<path d="m12 19V5"></path><path d="m5 12 7-7 7 7"></path>`,
    calendar: `<rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path>`,
    clock: `<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>`,
    copy: `<rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>`,
    edit: `<path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>`,
    file: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path>`,
    markdown: `<rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M7 15V9l2.5 3L12 9v6"></path><path d="M15 9v6"></path><path d="m13 13 2 2 2-2"></path>`,
    quote: `<path d="M3 21c3 0 7-1 7-8V5H3v8h4c0 4-2 6-4 6v2Z"></path><path d="M14 21c3 0 7-1 7-8V5h-7v8h4c0 4-2 6-4 6v2Z"></path>`,
    refresh: `<path d="M21 12a9 9 0 0 1-9 9 9.8 9.8 0 0 1-6.7-2.7L3 16"></path><path d="M3 21v-5h5"></path><path d="M3 12a9 9 0 0 1 9-9 9.8 9.8 0 0 1 6.7 2.7L21 8"></path><path d="M21 3v5h-5"></path>`,
    share: `<circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4"></path><path d="m15.4 6.5-6.8 4"></path>`,
    tag: `<path d="M20.6 13.1 13 20.7a2 2 0 0 1-2.8 0L3.3 13.8a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h7.4a2 2 0 0 1 1.4.6l7.1 7.1a1.9 1.9 0 0 1 0 2.4Z"></path><circle cx="7.5" cy="7.5" r=".5"></circle>`,
  };

  return icons[name] ?? "";
}
---

<PapyrusBaseLayout title={title} description={description} siteTitle={siteTitle} headerTitle={headerTitle} brandTitle={brandTitle} brandMark={brandMark} brandAriaLabel={brandAriaLabel} showBrandTitle={showBrandTitle} defaultThemeProfile={defaultThemeProfile} defaultFontProfile={defaultFontProfile} canonicalURL={canonicalUrl} robots={robots} googleVerification={googleVerification} nav={nav} socialLinks={socialLinks} features={features}>
  {resolvedFeatures.aiMetadata && (
  <PapyrusAiMetadata
      id={canonicalUrl ? `${canonicalUrl.replace(/#.*$/, "")}#post` : undefined}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      sourceUrl={sourceUrl}
      datePublished={published}
      dateModified={modDatetime}
      tags={tags}
      author={author}
    />
  )}
  <article class="papyrus-post" data-pagefind-body={shouldIndexWithPagefind ? true : undefined}>
    {backHref && (
      <p class="papyrus-post-back">
        <a href={withBase(backHref)}>
          <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("arrowLeft")} />
          <span>{backLabel}</span>
        </a>
      </p>
    )}
    {resolvedFeatures.toc && (
      <div class="papyrus-post-toc-top">
        <PapyrusToc headings={headings} links={tocLinks} collapsed={tocCollapsed} />
      </div>
    )}
    {
      cover && (
        <figure class:list={["papyrus-post-cover-frame", coverEffectClass]}>
          <img src={getAssetPath(cover)} alt="" decoding="async" fetchpriority="high" />
        </figure>
      )
    }
    <header class="papyrus-post-header">
      <h1 transition:name={toTransitionName(title)}>{title}</h1>
      {description && <p class="papyrus-description">{description}</p>}
    </header>
    <div class="papyrus-prose">
      <slot />
    </div>
    {
      ((resolvedFeatures.postSideLinks && sideLinks.length > 0) || showPostActions) && (
        <div class="papyrus-post-side-links">
          {
            resolvedFeatures.postSideLinks && sideLinks.length > 0 && (
              <nav aria-label="More links">
                {sideLinks.map(link => (
                  <a href={withBase(link.href)}>
                    <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("arrowLeft")} />
                    <span>Back</span>
                  </a>
                ))}
              </nav>
            )
          }
          {showPostActions && (
            <p class="papyrus-post-tools" aria-label="Post actions">
              {resolvedFeatures.sourceActions && editUrl && (
              <a href={editUrl}>
                <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("edit")} />
                <span>Edit post</span>
              </a>
            )}
              {resolvedFeatures.sourceActions && sourceUrl && (
              <button class="papyrus-share-button" type="button" data-papyrus-copy-source={sourceUrl} title="Copy source">
                <span class="papyrus-share-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icon("copy")} />
                </span>
                <span class="papyrus-share-copy">
                  <span class="papyrus-button-label">Copy</span>
                </span>
              </button>
            )}
              {resolvedFeatures.sourceActions && resolvedSourceLinkUrl && (
              <button class="papyrus-share-button" type="button" data-papyrus-copy-source-link={resolvedSourceLinkUrl} title="Copy source link">
                <span class="papyrus-share-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icon("markdown")} />
                </span>
                <span class="papyrus-share-copy">
                  <span class="papyrus-button-label">Source</span>
                </span>
              </button>
              )}
              {resolvedFeatures.share && (
              <button class="papyrus-share-button" type="button" data-papyrus-share title="Share this post">
                <span class="papyrus-share-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icon("share")} />
                </span>
                <span class="papyrus-share-copy">
                  <span class="papyrus-button-label">Share</span>
                </span>
              </button>
              )}
            </p>
          )}
        </div>
      )
    }
    {
      resolvedFeatures.postStats && (commentsCount !== undefined || viewsCount !== undefined) && (
        <p class="papyrus-post-stats">
          {viewsCount !== undefined && <span>{viewsCount} views</span>}
          {commentsCount !== undefined && <span>{commentsCount} comments</span>}
        </p>
      )
    }
    <slot name="stats" />
    <slot name="after" />
    {
      showPostFooter && (
        <footer class="papyrus-post-footer">
          {showPostMeta && (
            <p class="papyrus-kicker">
              {formattedDate && (
                <span class="papyrus-meta-item">
                  <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("calendar")} />
                  {formattedDate}
                </span>
              )}
              {showUpdated && (
                <span class="papyrus-meta-item">
                  <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("refresh")} />
                  {formattedUpdated}
                </span>
              )}
              {readingTime && (
                <span class="papyrus-meta-item">
                  <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("clock")} />
                  {readingTime}
                </span>
              )}
            </p>
          )}
          {
            resolvedFeatures.postTags && tags.length > 0 && (
              <div class="papyrus-post-meta-row">
                <p class="papyrus-tags">
                  <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("tag")} />
                  {tags.map(tag => <a href={tagHref(tag)}>#{tag}</a>)}
                </p>
                <a class="papyrus-post-top-link" href="#top" aria-label="Back to top" title="Back to top">
                  <svg aria-hidden="true" viewBox="0 0 24 24" set:html={icon("arrowUp")} />
                  <span>Back to top</span>
                </a>
              </div>
            )
          }
        </footer>
      )
    }
    {resolvedFeatures.adjacentPosts && <PapyrusAdjacentPosts previous={previous} next={next} basePath={adjacentBasePath} />}
  </article>
  {((resolvedFeatures.sourceActions && (sourceUrl || resolvedSourceLinkUrl)) || resolvedFeatures.share) && <PapyrusPostActionsRuntime />}
  {(resolvedFeatures.artifactLinks || resolvedFeatures.imageZoom || resolvedFeatures.mermaid) && (
    <PapyrusMediaRuntime
      artifactLinks={resolvedFeatures.artifactLinks}
      imageZoom={resolvedFeatures.imageZoom}
      mermaid={resolvedFeatures.mermaid}
    />
  )}
  {resolvedFeatures.backToTop && <PapyrusBackToTopRuntime />}
  <div class="papyrus-scroll-progress" aria-hidden="true">
    <div class="papyrus-scroll-progress-bar" data-papyrus-scroll-progress></div>
  </div>
  <script is:inline data-astro-rerun>
    (() => {
      window.__papyrusScrollProgressController?.abort?.();
      const controller = new AbortController();
      window.__papyrusScrollProgressController = controller;

      const progressBar = document.querySelector("[data-papyrus-scroll-progress]");
      if (!progressBar) return;

      function updateScrollProgress() {
        const root = document.documentElement;
        const scrollTotal = root.scrollHeight - root.clientHeight;
        const scrollTop = document.body.scrollTop || root.scrollTop;
        const progress = scrollTotal > 0 ? Math.min(100, Math.max(0, (scrollTop / scrollTotal) * 100)) : 0;
        progressBar.style.width = `${progress}%`;
      }

      updateScrollProgress();
      document.addEventListener("scroll", updateScrollProgress, { passive: true, signal: controller.signal });
      window.addEventListener("resize", updateScrollProgress, { passive: true, signal: controller.signal });
    })();
  </script>
</PapyrusBaseLayout>
