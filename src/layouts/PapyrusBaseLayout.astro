---
import { ClientRouter } from "astro:transitions";
import PapyrusHeader from "../components/PapyrusHeader.astro";
import PapyrusFooter from "../components/PapyrusFooter.astro";
import PapyrusThemeProvider from "../components/PapyrusThemeProvider.astro";
import PapyrusThemeBootstrap from "../components/PapyrusThemeBootstrap.astro";
import { loadPapyrusConfig, type PapyrusAnalyticsConfig, type PapyrusHeadConfig, type PapyrusMarkdownStyleConfig, type PapyrusVerificationConfig } from "../config";
import { resolvePapyrusFeatures, type PapyrusFeatureConfig } from "../utils/features";
import { getAssetPath, stripBase, withBase } from "../utils/withBase";
import "../styles/papyrus.css";

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  siteTitle?: string;
  headerTitle?: string;
  brandTitle?: string;
  brandMark?: "twinkle" | "terminal";
  brandAriaLabel?: string;
  showBrandTitle?: boolean;
  defaultThemeProfile?: string;
  defaultFontProfile?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  ogImageType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogLocale?: string;
  twitterSite?: string;
  robots?: string;
  googleVerification?: string;
  verification?: PapyrusVerificationConfig[];
  analytics?: PapyrusAnalyticsConfig;
  head?: PapyrusHeadConfig;
  markdown?: Partial<PapyrusMarkdownStyleConfig>;
  nav?: NavItem[];
  footerLinks?: NavItem[];
  socialLinks?: Array<{ href: string; label: string; icon?: string }>;
  rssHref?: string;
  poweredBy?: boolean;
  searchHref?: string;
  features?: PapyrusFeatureConfig;
}

const {
  title,
  description = "",
  siteTitle = title,
  headerTitle,
  brandTitle,
  brandMark,
  brandAriaLabel,
  showBrandTitle,
  defaultThemeProfile = "gruvbox",
  defaultFontProfile = "readable",
  canonicalURL,
  ogType = "website",
  ogImage,
  ogImageAlt,
  ogImageType,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogLocale,
  twitterSite,
  robots,
  googleVerification,
  verification,
  analytics,
  head,
  markdown,
  nav = [],
  footerLinks,
  socialLinks = [],
  rssHref = "/rss.xml",
  poweredBy = true,
  searchHref = "/search/",
  features,
} = Astro.props;

const configuredSite = await loadPapyrusConfig();
function localeForOpenGraph(configuredLocale: string | undefined, language: string): string {
  if (configuredLocale) return configuredLocale.replace("-", "_");
  try {
    const locale = new Intl.Locale(language).maximize();
    return locale.region ? `${locale.language}_${locale.region}` : locale.language;
  } catch {
    return language.replace("-", "_");
  }
}

function contentTypeForImage(url: string | undefined): string | undefined {
  if (!url) return undefined;
  const pathname = new URL(url).pathname.toLowerCase();
  if (pathname.endsWith(".png")) return "image/png";
  if (pathname.endsWith(".jpg") || pathname.endsWith(".jpeg")) return "image/jpeg";
  if (pathname.endsWith(".webp")) return "image/webp";
  if (pathname.endsWith(".gif")) return "image/gif";
  if (pathname.endsWith(".svg")) return "image/svg+xml";
  return undefined;
}

const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const resolvedFeatures = resolvePapyrusFeatures({
  poweredBy,
  ...features,
});
const resolvedSearchHref = resolvedFeatures.search ? searchHref : undefined;
const resolvedRssHref = resolvedFeatures.rss ? rssHref : undefined;
const showHeader = resolvedFeatures.header;
const showFooter = resolvedFeatures.footer;
const resolvedLanguage = configuredSite.lang ?? "en";
const resolvedBrandMark = brandMark ?? (headerTitle ? "terminal" : "twinkle");
const resolvedBrandTitle = brandTitle ?? headerTitle ?? siteTitle;
const resolvedShowBrandTitle = showBrandTitle ?? !headerTitle;
const resolvedCanonicalURL = canonicalURL ? new URL(withBase(canonicalURL), Astro.site ?? Astro.url).href : undefined;
const resolvedOgImage = ogImage ? new URL(getAssetPath(ogImage), Astro.site ?? Astro.url).href : undefined;
const resolvedOgImageType = ogImageType ?? contentTypeForImage(resolvedOgImage);
const resolvedOgLocale = localeForOpenGraph(ogLocale ?? configuredSite.ogLocale, resolvedLanguage);
const resolvedTwitterSite = twitterSite ?? configuredSite.twitterSite;
const resolvedPageUrl = resolvedCanonicalURL ?? new URL(withBase(stripBase(Astro.url.pathname)), Astro.site ?? Astro.url).href;
const resolvedNav = nav.map(item => ({ ...item, href: withBase(item.href) }));
const resolvedFooterLinks = (footerLinks ?? configuredSite.footerLinks).map(item => ({ ...item, href: withBase(item.href) }));
const resolvedSocialLinks = socialLinks.map(item => ({ ...item, href: withBase(item.href) }));
const headerHomeHref = withBase("/");
const resolvedVerification = [
  ...(googleVerification ? [{ name: "google-site-verification", content: googleVerification }] : []),
  ...(verification ?? configuredSite.verification),
].filter((item, index, items) => items.findIndex(other => other.name === item.name && other.content === item.content) === index);
const resolvedAnalytics = analytics ?? configuredSite.analytics;
const resolvedHead = head ?? configuredSite.head;
const resolvedMarkdown = {
  ...configuredSite.markdown,
  ...(markdown ?? {}),
};
const showAnalytics = resolvedAnalytics.enabled && (import.meta.env.PROD || resolvedAnalytics.includeInDev);
const analyticsProvider = resolvedAnalytics.provider;
const analyticsId = resolvedAnalytics.id;
const plausibleDomain = resolvedAnalytics.domain ?? (Astro.site ?? Astro.url).hostname;
---

<!doctype html>
<html
  lang={resolvedLanguage}
  data-papyrus-theme={defaultThemeProfile}
  data-papyrus-font={defaultFontProfile}
  data-papyrus-markdown-link-style={resolvedMarkdown.linkStyle}
  data-papyrus-markdown-heading-style={resolvedMarkdown.headingStyle}
  data-papyrus-markdown-marker-style={resolvedMarkdown.markerStyle}
  data-papyrus-markdown-blockquote-style={resolvedMarkdown.blockquoteStyle}
  data-papyrus-markdown-table-style={resolvedMarkdown.tableStyle}
  data-papyrus-markdown-table-header-style={resolvedMarkdown.tableHeaderStyle}
  data-papyrus-markdown-inline-code-style={resolvedMarkdown.inlineCodeStyle}
>
  <head>
    <meta charset="utf-8" />
    <PapyrusThemeBootstrap defaultThemeProfile={defaultThemeProfile} defaultFontProfile={defaultFontProfile} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    {resolvedVerification.map(item => <meta name={item.name} content={item.content} />)}
    {resolvedHead.meta.map(item => <meta {...item} />)}
    {resolvedHead.links.map(item => <link {...item} />)}
    {showAnalytics && analyticsProvider === "ga4" && analyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(analyticsId)}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag("js", new Date());
          gtag("config", analyticsId);
        </script>
      </>
    )}
    {showAnalytics && analyticsProvider === "plausible" && (
      <script is:inline defer data-domain={plausibleDomain} src={resolvedAnalytics.src ?? "https://plausible.io/js/script.js"}></script>
    )}
    {showAnalytics && analyticsProvider === "umami" && analyticsId && (
      <script is:inline defer src={resolvedAnalytics.src ?? "https://cloud.umami.is/script.js"} data-website-id={analyticsId}></script>
    )}
    {showAnalytics && analyticsProvider === "goatcounter" && analyticsId && (
      <script is:inline async src={resolvedAnalytics.src ?? "https://gc.zgo.at/count.js"} data-goatcounter={`https://${analyticsId}.goatcounter.com/count`}></script>
    )}
    {showAnalytics && analyticsProvider === "custom" && resolvedAnalytics.src && (
      <script is:inline defer src={resolvedAnalytics.src}></script>
    )}
    {resolvedHead.scripts.map(item => <script is:inline {...item}></script>)}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FCFCFD" />
    <link rel="icon" href={getAssetPath("/favicon-32x32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={getAssetPath("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={getAssetPath("/site.webmanifest")} />
    <link rel="apple-touch-icon" href={getAssetPath("/apple-touch-icon.png")} />
    {resolvedCanonicalURL && <link rel="canonical" href={resolvedCanonicalURL} />}
    {resolvedRssHref && <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href={new URL(withBase(resolvedRssHref), Astro.site ?? Astro.url).href} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:url" content={resolvedPageUrl} />
    {resolvedOgLocale && <meta property="og:locale" content={resolvedOgLocale} />}
    {description && <meta property="og:description" content={description} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {resolvedOgImage && resolvedOgImageType && <meta property="og:image:type" content={resolvedOgImageType} />}
    {resolvedOgImage && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {resolvedOgImage && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {resolvedOgImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    {resolvedTwitterSite && <meta name="twitter:site" content={resolvedTwitterSite} />}
    {description && <meta name="twitter:description" content={description} />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {resolvedOgImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <title>{pageTitle}</title>
    <PapyrusThemeProvider defaultThemeProfile={defaultThemeProfile} defaultFontProfile={defaultFontProfile} />
    <ClientRouter />
  </head>
  <body>
    <div class="papyrus-shell">
      {showHeader && <PapyrusHeader title={headerTitle} brandTitle={resolvedBrandTitle} brandMark={resolvedBrandMark} brandAriaLabel={brandAriaLabel} showBrandTitle={resolvedShowBrandTitle} homeHref={headerHomeHref} nav={resolvedNav} searchHref={resolvedSearchHref ? withBase(resolvedSearchHref) : undefined} />}
      <main id="top" class="papyrus-main">
        <slot />
      </main>
      {showFooter && <PapyrusFooter title={siteTitle} links={resolvedFooterLinks} socialLinks={resolvedSocialLinks} rssHref={resolvedRssHref ? withBase(resolvedRssHref) : undefined} poweredBy={resolvedFeatures.poweredBy} themeControls={resolvedFeatures.themeControls} />}
    </div>
    {showHeader && resolvedFeatures.scrollHeader && <script>
      let lastScrollY = window.scrollY;
      let headerScrollController: AbortController | undefined;

      function bindHeaderScroll() {
        headerScrollController?.abort();
        headerScrollController = new AbortController();
        const header = document.querySelector<HTMLElement>("[data-papyrus-header]");
        if (!header) return;

        window.addEventListener("scroll", () => {
          const currentScrollY = window.scrollY;
          const movingDown = currentScrollY > lastScrollY && currentScrollY > 80;
          header.dataset.papyrusHidden = movingDown ? "true" : "false";
          lastScrollY = currentScrollY;
        }, { passive: true, signal: headerScrollController.signal });
      }

      bindHeaderScroll();
      document.addEventListener("astro:page-load", bindHeaderScroll);
    </script>}
  </body>
</html>
